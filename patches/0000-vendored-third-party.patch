+template <class Cmp>
+std::vector<int> ArgSort(size_t size, const Cmp& cmp) {
+  std::vector<int> idxs(size);
+  std::iota(idxs.begin(), idxs.end(), 0);
+  std::stable_sort(idxs.begin(), idxs.end(), cmp);
+  return idxs;
