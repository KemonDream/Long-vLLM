+                    g_shared[j_s] = g[
+                        batch_idx, seq_start_idx + (num_iters - 1) * block_S + j_s, bh
+                    ]
+                else:
+                    g_shared[j_s] = g[batch_idx, seq_end_idx - 1, bh]
