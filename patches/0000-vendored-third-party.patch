+    asm("cvt.rni.sat.u32.f32 %0, %1;\n" : "=r"(y) : "f"(x));
+  } else if constexpr (std::is_same_v<T, int32_t>) {
+    asm("cvt.rni.sat.s32.f32 %0, %1;\n" : "=r"(y) : "f"(x));
+  } else {
+    static_assert(!std::is_same_v<T, T>, "not implemented");
+  }
+  return y;
