+
+#define BLOCK_M_64 64
+#define BLOCK_N_64 128
+#define WARPS_64 16
+
+#define BLOCK_M_128 32
+#define BLOCK_N_128 176
+#define WARPS_128 16
+
+#define BLOCK_M_256 32
