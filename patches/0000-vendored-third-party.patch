+static inline bool operator==(const int3& a, const int3& b)
+{
+    return a.x == b.x && a.y == b.y && a.z == b.z;
+}
+
+static inline bool operator==(const int2& a, const int2& b)
+{
+    return a.x == b.x && a.y == b.y;
+}
+
+namespace turbomind::gemm {
