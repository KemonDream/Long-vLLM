+void launch_gdn_decode_mixed_qkv_ddtree_state_typed(
+    const scalar_t* mixed_qkv,
+    const scalar_t* a,
+    const scalar_t* b,
+    const float* A_log,
+    const bias_t* dt_bias,
+    state_t* state,
