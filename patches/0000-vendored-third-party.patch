+                        ] += dh_fragment[j_k, j_v] * h_shared[j_k, j_v]
+                    T.barrier_arrive(bar_08)
+                    T.barrier_wait(bar_08, (i_s + 0) % 2)
+                    T.barrier_wait(bar_09, (i_s + 0) % 2)
