+struct EpilogueParam {
+    MatrixParam c;
+    MatrixParam partials;
+    int*        locks;
+
+    // MatrixParam scale_S;
+    // MatrixParam scale_C;
+
+    MatrixCombination_v3 combine_mat;
+
+    bool         silu_act;
+    bool         moe_weighted_reduce;
+    void*        moe_reduce_out;
