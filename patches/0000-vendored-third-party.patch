+                a16o_fragment[j_s, k_s, k_t] += (
+                    a16o_shared[j_s, k_r, k_s] * a16i_shared[j_s * 2, k_r, k_t]
+                )
+        T.copy(a16o_fragment, a16o_shared[:, 0:16, 0:16])
+
+        for j_s, k_s, k_t in T.Parallel(2, 32, 32):
+            if k_s < 16 and k_t >= 16:
