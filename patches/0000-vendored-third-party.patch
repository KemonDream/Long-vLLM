+    else if constexpr (sizeof(Array<T, N>) == sizeof(uint1)) {
+        __stcs((uint*)dst, (const uint&)src);
+    }
+    else if constexpr (sizeof(Array<T, N>) == sizeof(uint16_t)) {
+        __stcs((uint16_t*)dst, (const uint16_t&)src);
