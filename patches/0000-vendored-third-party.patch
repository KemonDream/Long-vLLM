+        }
+    };
+
+    using GetGmemIter = GetGmemIter;
+};
+
+}  // namespace simt
+
+template<class T>
+struct GetOperand<HMMA_SIMT, OPERAND_A, T, kRowMajor, false>: std::true_type {
+    using Operand = simt::Operand_A<T, simt::OP_K>;
+};
+
