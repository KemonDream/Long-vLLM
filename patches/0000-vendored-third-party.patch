+template <class T>
+__device__ constexpr T Max(T a, T b) {
+  if constexpr (std::is_same_v<T, half>) {
+    return __hmax(a, b);
+  }
+
+#if __CUDA_ARCH__ >= 800
+  if constexpr (std::is_same_v<T, nv_bfloat16>) {
+    return __hmax(a, b);
+  }
+#endif
+
+  if constexpr (std::is_same_v<T, float>) {
+    return fmaxf(a, b);
+  }
+
+  if constexpr (std::is_same_v<T, int>) {
+    return max(a, b);
+  }
+
+  return T{};
+}
