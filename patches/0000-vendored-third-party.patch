+template <class T>
+struct ConvertKvCache<uint8_t, T> {
+  T scale_;
+  T zero_;
+  __device__ ConvertKvCache(T scale, T zero) : scale_{scale}, zero_{zero} {}
+
+  template <int N>
+  __device__ static auto convert(const Array<uint8_t, N>& vi) {
+    Array<T, N> vo;
+    PRAGMA_UNROLL
