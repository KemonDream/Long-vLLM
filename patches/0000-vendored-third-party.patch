+                if seq_start_idx + (num_iters - 1) * block_S + j_s < seq_end_idx:
+                    v_shared[j_s, j_v] = v[
+                        batch_idx,
+                        seq_start_idx + (num_iters - 1) * block_S + j_s,
+                        bh,
+                        j_v,
+                    ]
+                else:
+                    v_shared[j_s, j_v] = 0
+            for j_s, j_t in T.Parallel(block_S, block_S):
+                if seq_start_idx + (num_iters - 1) * block_S + j_s < seq_end_idx:
+                    a_shared[j_s, j_t] = a[
+                        batch_idx,
+                        seq_start_idx + (num_iters - 1) * block_S + j_s,
+                        bh,
+                        j_t,
+                    ]
+                else:
+                    a_shared[j_s, j_t] = 0
