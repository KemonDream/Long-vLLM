+    k_norm = subgroup_broadcast(subgroup_sum(k_norm, WIDTH), WIDTH);
+    const float q_inv = rsqrtf(q_norm + 1.0e-6F);
+    const float k_inv = rsqrtf(k_norm + 1.0e-6F);
