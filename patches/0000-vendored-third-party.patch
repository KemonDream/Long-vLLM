+                        tmp_shared_2_1,
+                        tmp_shared_2_3,
+                        dh_fragment,
+                        transpose_A=True,
+                        clear_accum=False,
+                    )
+                    T.barrier_arrive(bar_15)
+
+                    # 15
+                    T.barrier_wait(bar_15, (i_s + 0) % 2)
+                    # S4[1] = dS0
+                    T.copy(dh_fragment, tmp_shared_4_1)
+
+                if use_dht:
+                    T.copy(dh_fragment, dh0[bb, bh, 0:DK, 0:DV])
+
+            elif tx < 256:
