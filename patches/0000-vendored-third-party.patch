+            if k_s // 16 == k_t // 16:
+                a32i_fragment[j_s, k_s, k_t] = a16i_shared[
+                    j_s * 2 + k_s // 16, k_s % 16, k_t % 16
+                ]
+        for j_s, k_s, k_t in T.Parallel(2, 32, 32):
+            if j_s == 0:
+                a32i0_shared[k_s, k_t] = a32i_fragment[j_s, k_s, k_t]
+            else:
