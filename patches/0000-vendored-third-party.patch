+                    T.copy(k_shared, odot_fragment_1)
+                    T.copy(odot_fragment_1, tmp_shared_2_2)
+                    T.barrier_arrive(bar_07)
+
+                    # 07
+                    T.barrier_wait(bar_07, (i_s + 0) % 2)
