-class CustomAllreduce {
- public:
-  int rank_;
-  int world_size_;
-  // Full NVLink or xGMI connection between GPUs.
-  bool fully_connected_;
-
-  RankSignals sg_;
-  // Stores a map from a pointer to its peer pointers from all ranks.
