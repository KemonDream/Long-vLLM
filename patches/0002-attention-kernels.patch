+struct ScopedCleanup {
+  std::function<void()> fn;
+  ~ScopedCleanup() noexcept {
+    if (fn) fn();
+  }
+  void release() noexcept {
+    fn = nullptr;
+  }
+};
+
+using Element = cutlass::half_t;
+using TailOutput = float;
+
+using QKAccumulator = float;
