+                                       std::nullopt, q.device());
+    tail_scores = torch::stable::empty(
+        {static_cast<int64_t>(kTailScoreElements)}, q.scalar_type(), std::nullopt,
+        q.device());
+    tail_numerator = torch::stable::empty(
+        {kRows, kHeadDim}, q.scalar_type(), std::nullopt, q.device());
+    tail_row_sums = torch::stable::empty(
+        {kFinePVTasks, kTailTileRows}, torch::headeronly::ScalarType::Float,
+        std::nullopt, q.device());
+    tail_max = torch::stable::empty({kRows}, torch::headeronly::ScalarType::Float,
+                                     std::nullopt, q.device());
+    tail_sum = torch::stable::empty({kRows}, torch::headeronly::ScalarType::Float,
+                                     std::nullopt, q.device());
+    tail_q_ptrs = torch::stable::empty({static_cast<int64_t>(kTailTasks * sizeof(Element*))},
+                                        torch::headeronly::ScalarType::Byte, std::nullopt,
+                                        q.device());
+    tail_k_ptrs = torch::stable::empty({static_cast<int64_t>(kTailTasks * sizeof(Element*))},
+                                        torch::headeronly::ScalarType::Byte, std::nullopt,
+                                        q.device());
+    tail_score_ptrs = torch::stable::empty(
+        {static_cast<int64_t>(kTailTasks * sizeof(ScoreElement*))},
