+torch::stable::Tensor private_grouped_e4m3_fp32_paged(
+    const torch::stable::Tensor& q, const torch::stable::Tensor& k, const torch::stable::Tensor& v,
+    torch::stable::Tensor& out, const torch::stable::Tensor& block_table,
+    const torch::stable::Tensor& row_lengths, torch::stable::Tensor& partial, torch::stable::Tensor& lse,
+    float scale, float k_scale, float v_scale) {
+  TORCH_CHECK(q.is_cuda() && q.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  q.is_contiguous() && q.dim() == 3 && q.size(0) >= 2 &&
+                  q.size(0) <= 8 && q.size(1) == 6 && q.size(2) == 256,
+              "E4M3 grouped FP32 requires contiguous CUDA FP16 Q [2..8,6,256]");
+  TORCH_CHECK(
+      k.dim() == 4 && k.size(2) == 1 && k.size(3) == 256 &&
+          k.size(1) > 0 && k.size(1) % 16 == 0 &&
+          k.scalar_type() == torch::headeronly::ScalarType::Byte && v.scalar_type() == torch::headeronly::ScalarType::Byte &&
+           v.sizes().vec() == k.sizes().vec(),
+      "E4M3 grouped FP32 requires supported uint8 paged KV [pages,page,1,256]");
+  TORCH_CHECK(
+      block_table.dim() == 2 && block_table.size(0) == 1 &&
+          block_table.is_contiguous() &&
+          block_table.scalar_type() == torch::headeronly::ScalarType::Int && block_table.size(1) > 0 &&
+          block_table.size(1) * k.size(1) <= 266240 &&
+           row_lengths.sizes().vec() == torch::headeronly::IntHeaderOnlyArrayRef({q.size(0)}).vec() &&
+          row_lengths.scalar_type() == torch::headeronly::ScalarType::Int && row_lengths.is_contiguous(),
+      "E4M3 grouped FP32 requires one KV sequence and per-query int32 lengths");
+   TORCH_CHECK(out.sizes().vec() == q.sizes().vec() && out.is_contiguous() &&
+                   out.scalar_type() == torch::headeronly::ScalarType::Half,
+              "E4M3 grouped FP32 output must be contiguous FP16 and Q-shaped");
+   TORCH_CHECK(partial.sizes().vec() == torch::headeronly::IntHeaderOnlyArrayRef({80, 8, 6, 256}).vec() &&
+                   partial.is_contiguous() &&
+                   partial.scalar_type() == torch::headeronly::ScalarType::Float &&
+                   lse.sizes().vec() == torch::headeronly::IntHeaderOnlyArrayRef({80, 8, 6, 2}).vec() &&
+                   lse.is_contiguous() && lse.scalar_type() == torch::headeronly::ScalarType::Float,
+              "E4M3 grouped FP32 requires numerator [80,8,6,256] and max/sum "
+              "[80,8,6,2]");
+  TORCH_CHECK(
+      std::isfinite(scale) && std::isfinite(k_scale) &&
+          std::isfinite(v_scale) && k_scale > 0 && v_scale > 0,
+      "E4M3 grouped FP32 requires finite scale and positive finite KV scales");
+  for (const auto* t :
+       {&k, &v, static_cast<const torch::stable::Tensor*>(&out), &block_table,
+        &row_lengths, static_cast<const torch::stable::Tensor*>(&partial),
+        static_cast<const torch::stable::Tensor*>(&lse)}) {
+    TORCH_CHECK(t->device() == q.device(),
+                "E4M3 grouped tensors must share device");
+  }
+  for (const auto* t : {&k, &v}) {
+    // Explicit-row FP32 groups retain the 8-byte loader. The dense q8
+    // verifier's paired loader requires 16-byte strides and is gated there;
+    // inheriting it here would truncate valid 8-but-not-16-byte offsets.
+    TORCH_CHECK(t->stride(3) == 1 &&
+                    reinterpret_cast<uintptr_t>(t->data_ptr()) % 16 == 0,
+                "E4M3 grouped KV requires aligned contiguous head dimension");
+    for (int i = 0; i < 3; ++i)
+      TORCH_CHECK(t->stride(i) % 8 == 0,
+                  "E4M3 grouped KV strides must be multiples of 8");
+  }
+  torch::stable::accelerator::DeviceGuard guard(q.get_device_index());
+  cudaDeviceProp properties;
+  C10_CUDA_CHECK(cudaGetDeviceProperties(&properties, q.get_device()));
+  TORCH_CHECK(properties.major == 7 && properties.minor == 0,
+              "E4M3 grouped FP32 supports SM70 only");
+  // A contiguous FP16 view can start at a half-element storage offset.
+  // The shared-Q feed uses uint4 loads; only those exceptional views need
+  // an aligned, stream-local copy. Ordinary model Q keeps the original path.
+  const torch::stable::Tensor aligned_q =
+      reinterpret_cast<uintptr_t>(q.data_ptr()) % 16 == 0 ? q : torch::stable::clone(q);
+  const auto stream = get_current_cuda_stream();
+  bool paired = true;
+  for (const auto* tensor : {&k, &v}) {
+    for (int dim = 0; dim < 3; ++dim)
+      paired = paired && tensor->stride(dim) % 16 == 0;
+  }
+  auto kernel = paired
+      ? flash_attention_grouped_verify_e5m2_partial_kernel<
+          8, false, 0, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3,
+          false, float, true, true, true>
+      : flash_attention_grouped_verify_e5m2_partial_kernel<
+          8, false, 0, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3,
+          false, float, true, true, false>;
+  if (k.size(1) == 1648) kernel = paired ? flash_attention_grouped_verify_e5m2_partial_kernel<8, false, 1648, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3, false, float, true, true, true> : flash_attention_grouped_verify_e5m2_partial_kernel<8, false, 1648, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3, false, float, true, true, false>;
+  if (k.size(1) == 3296) kernel = paired ? flash_attention_grouped_verify_e5m2_partial_kernel<8, false, 3296, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3, false, float, true, true, true> : flash_attention_grouped_verify_e5m2_partial_kernel<8, false, 3296, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3, false, float, true, true, false>;
+  if (q.size(0) == 8) {
+  kernel = paired
+      ? flash_attention_grouped_verify_e4m3_full_q8_kernel<
+          8, false, 0, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3,
+          false, float, true, true, true>
+      : flash_attention_grouped_verify_e4m3_full_q8_kernel<
+          8, false, 0, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3,
+          false, float, true, true, false>;
+  if (k.size(1) == 1648) kernel = paired ? flash_attention_grouped_verify_e4m3_full_q8_kernel<8, false, 1648, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3, false, float, true, true, true> : flash_attention_grouped_verify_e4m3_full_q8_kernel<8, false, 1648, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3, false, float, true, true, false>;
+  if (k.size(1) == 3296) kernel = paired ? flash_attention_grouped_verify_e4m3_full_q8_kernel<8, false, 3296, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3, false, float, true, true, true> : flash_attention_grouped_verify_e4m3_full_q8_kernel<8, false, 3296, false, false, false, flash_v100::KV_CACHE_DTYPE_FP8_E4M3, false, float, true, true, false>;
+  }
+  constexpr int kCompensatedSmemBytes =
+      sizeof(GroupedVerifySmem) +
+      kGroupedVerifyRows * kGroupedVerifyProbStride * sizeof(__half) +
+      kGroupedVerifyBlockN * kGroupedVerifyKVStride * sizeof(__half);
+  static_assert(kCompensatedSmemBytes <= 96 * 1024,
+                "compensated P and prefetched V must fit the SM70 budget");
+  TORCH_CHECK(properties.sharedMemPerBlockOptin >= kCompensatedSmemBytes,
+              "V prefetch exceeds device opt-in shared memory");
+  C10_CUDA_CHECK(
+      cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize,
+                           kCompensatedSmemBytes));
+  C10_CUDA_CHECK(cudaFuncSetAttribute(
+      kernel, cudaFuncAttributePreferredSharedMemoryCarveout, 100));
+  kernel<<<dim3(1, 80), kGroupedVerifyThreads, kCompensatedSmemBytes, stream>>>(
+       reinterpret_cast<const __half*>(aligned_q.const_data_ptr<__half>()), k.const_data_ptr<uint8_t>(),
+       v.const_data_ptr<uint8_t>(), block_table.const_data_ptr<int>(), row_lengths.const_data_ptr<int>(),
+       partial.mutable_data_ptr<float>(), lse.mutable_data_ptr<float>(), q.size(0),
+       block_table.size(1), k.size(1), k.stride(0), k.stride(1), k.stride(2),
+       v.stride(0), v.stride(1), v.stride(2), scale * k_scale, v_scale, nullptr,
+       1, row_lengths.const_data_ptr<int>());
+  flash_attention_grouped_verify_e5m2_combine_kernel<8, false, float, true>
+      <<<dim3(q.size(0), 6), kGroupedVerifyThreads, 0, stream>>>(
+           partial.mutable_data_ptr<float>(), lse.mutable_data_ptr<float>(),
+           row_lengths.const_data_ptr<int>(),
+           reinterpret_cast<__half*>(out.mutable_data_ptr<__half>()), q.size(0),
+           row_lengths.const_data_ptr<int>());
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  return out;
+}
