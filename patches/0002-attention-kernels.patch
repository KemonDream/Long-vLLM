+                        query_start_loc_cpu[:num_boundaries].to(
+                            device=query_start_loc.device,
+                            dtype=query_start_loc.dtype,
+                        ),
+                        non_blocking=True,
+                    )
+                flash_metadata.ddtree_query_start_loc_restored_for_triton = True
