+            reinterpret_cast<const __half*>(tmp_out.mutable_data_ptr<__half>()),
+            max_logits.mutable_data_ptr<float>(), exp_sums.mutable_data_ptr<float>(),
+            seq_lens.const_data_ptr<int>(), active_num_partitions.const_data_ptr<int>(),
+            reinterpret_cast<__half*>(out.mutable_data_ptr<__half>()), batch_size,
+            launch_num_partitions, num_heads_q, tmp_out.stride(0),
+            tmp_out.stride(1), tmp_out.stride(2), max_logits.stride(0),
+            max_logits.stride(1), out.stride(0), out.stride(1),
+            route_seq_len_end > 0 ? route_seq_len_end : route_seq_len_begin,
