+// Per-thread row ownership: 32 lanes form eight-lane groups; each group
+// owns four consecutive logical rows advanced by the caller's base offset.
+template <int kRows>
+__device__ __forceinline__ int sm70_row_slot(int slot, int lane) {
+  return slot * 4 + ((lane >> 2) & 3);
+}
+
+template <bool MergeExisting, typename ScoresT, typename WorkT>
+__device__ __forceinline__ void sm70_reduce_max(const ScoresT& scores,
+                                                 WorkT& work) {
+  static_assert(decltype(rank(scores))::value == 2);
+  #pragma unroll
+  for (int r = 0; r < decltype(size<0>(scores))::value; ++r) {
+    float m = MergeExisting ? work(r) : -INFINITY;
+    #pragma unroll
+    for (int c = 0; c < decltype(size<1>(scores))::value; ++c) {
+      m = fmaxf(m, static_cast<float>(scores(r, c)));
+    }
+    work(r) = m;
+  }
+}
+
+template <bool MergeExisting, typename ScoresT, typename WorkT>
+__device__ __forceinline__ void sm70_reduce_sum(const ScoresT& scores,
+                                                 WorkT& work) {
+  static_assert(decltype(rank(scores))::value == 2);
+  #pragma unroll
+  for (int r = 0; r < decltype(size<0>(scores))::value; ++r) {
+    float s = MergeExisting ? work(r) : 0.0f;
+    #pragma unroll
+    for (int c = 0; c < decltype(size<1>(scores))::value; ++c) {
+      s += static_cast<float>(scores(r, c));
+    }
+    work(r) = s;
+  }
+}
+
+template <typename ScoresT, typename MaxT>
+__device__ __forceinline__ void sm70_scale_apply_exp2(ScoresT& scores,
+                                                        const MaxT& row_max,
+                                                        float scale_log2) {
+  static_assert(decltype(rank(scores))::value == 2);
+  #pragma unroll
+  for (int r = 0; r < decltype(size<0>(scores))::value; ++r) {
+    const float mx = row_max(r);
+    const float safe_mx = (mx == -INFINITY) ? 0.0f : mx;
+    #pragma unroll
+    for (int c = 0; c < decltype(size<1>(scores))::value; ++c) {
+      scores(r, c) =
+          exp2f((static_cast<float>(scores(r, c)) - safe_mx) * scale_log2);
+    }
+  }
+}
+
+template <typename T, typename Op>
+__device__ __forceinline__ T sm70_row_allreduce_8(const T& v, Op& op) {
+  T result = v;
+  #pragma unroll
+  for (int bit = 1; bit < 8; bit <<= 1) {
+    T other = __shfl_xor_sync(static_cast<unsigned>(-1), result, bit);
+    result = op(result, other);
+  }
+  return result;
+}
