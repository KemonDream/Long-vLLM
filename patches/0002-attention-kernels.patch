+def _split_paged_kv_cache(
+    kv_cache: torch.Tensor | tuple[torch.Tensor, torch.Tensor] | list[torch.Tensor],
+) -> tuple[torch.Tensor, torch.Tensor]:
+    if isinstance(kv_cache, (list, tuple)):
+        if len(kv_cache) != 2:
+            raise ValueError(
+                f"Unexpected KV cache tuple/list length {len(kv_cache)}; expected 2"
+            )
+        return kv_cache[0], kv_cache[1]
+
+    if kv_cache.ndim < 2:
+        raise ValueError(
+            f"Unexpected KV cache shape {tuple(kv_cache.shape)}; "
+            "expected dimension 2 at axis 0 or 1"
+        )
+
+    # Current vLLM hands backends a logical per-layer cache
+    # (num_blocks, num_kv_heads, block_size, 2*head_size) (RFC #42082);
+    # upstream's flash_attn splits it with transpose(1, 2) + split(-1). The
+    # Flash-V100 kernels want the classic [num_blocks, block_size, heads, dim]
+    # per-K/V view, which is exactly that transform.
+    #
+    # This must be checked before the fused-axis heuristics below: a TP shard
+    # with two KV heads (e.g. 27B at TP2) has shape (B, 2, N, C) and would
+    # otherwise be misread as an old-style [B, 2 (K/V), N, C] cache.
+    if kv_cache.ndim == 4:
+        kv = kv_cache.transpose(1, 2)
+        head_size = kv.shape[-1] // 2
+        key_cache, value_cache = kv.split(head_size, dim=-1)
+        return key_cache, value_cache
+
+    # Legacy paged KV layout: [num_blocks, 2, block_size, heads, dim].
+    # Prefer axis 1 so num_blocks == 2 does not get mistaken for K/V.
+    if kv_cache.shape[1] == 2:
+        return kv_cache.unbind(1)
+    if kv_cache.shape[0] == 2:
+        return kv_cache.unbind(0)
+
+    raise ValueError(
+        f"Unexpected KV cache shape {tuple(kv_cache.shape)}; "
+        "expected dimension 2 at axis 0 or 1"
+    )
+
