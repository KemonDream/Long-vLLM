+  } else if constexpr (FP8_PAIR_LOAD) {
+    static_assert(!E4M3_SHARED_LUT, "The E4M3 conversion LUT requires E4M3 KV");
+    TORCH_CHECK(k_cache.scalar_type() == torch::headeronly::ScalarType::Byte,
