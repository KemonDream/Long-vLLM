+                        q_wmma,
+                        key_cache,
+                        value_cache,
+                        attn_metadata.block_table[:num_seqs],
+                        attn_metadata.seq_lens[:num_seqs],
+                        softmax_scale=self.scale,
+                        out=out_wmma,
+                        kv_cache_dtype=self.kv_cache_dtype,
