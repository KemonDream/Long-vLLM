index 0000000..50568d5
--- /dev/null
+++ b/csrc/attention/sm70_v37/tail.cu
@@ -0,0 +1,966 @@
+#undef FLASH_NAMESPACE
+#define FLASH_NAMESPACE onecat_v37_tail
+/******************************************************************************
+ * Copyright (c) 2026, 1CatAI.
+ ******************************************************************************/
+
+#include <cuda_runtime.h>
+#include <limits>
+#include <type_traits>
+
+#include <cute/tensor.hpp>
+#include <cutlass/numeric_types.h>
+
+#include "namespace_config.h"
+#include "kernel_traits.h"
+#include "utils.h"
+#include "softmax.h"
+#include "mask.h"
+
+namespace FLASH_NAMESPACE {
+
+using namespace cute;
+
+// 128-bit vectorized global load with an L2 caching hint for SM70
+// producers (V/K tiles loaded from paged or contiguous caches).
+template <class TS, class TD = TS>
+struct SM70_LDG_GLOBAL_CG_128b {
+  using SRegisters = TS[8];
+  using DRegisters = TD[8];
+
+  // cute's copy_unpack explodes the 8-element slices into individual
+  // scalar arguments, so the instruction entry point is variadic.
+  template <typename... SV, typename... DV>
+  CUTE_HOST_DEVICE static void copy(const SV&... svals, DV&... dvals) {
+    const void* src_addrs[16] = { &svals... };
+    const void* dst_addrs[16] = { &dvals... };
+    auto* sptr = reinterpret_cast<const TS*>(src_addrs[0]);
+    auto* dp = reinterpret_cast<TD*>(const_cast<void*>(dst_addrs[0]));
+#if defined(__CUDA_ARCH__)
+    uint4 val;
+    asm volatile("ld.global.cg.v4.u32 {%0,%1,%2,%3}, [%4];\n"
+                 : "=r"(val.x), "=r"(val.y), "=r"(val.z), "=r"(val.w)
+                 : "l"(sptr));
+    *reinterpret_cast<uint4*>(dp) = val;
+#else
+    *reinterpret_cast<uint4*>(dp) = *reinterpret_cast<const uint4*>(sptr);
+#endif
+  }
+};
