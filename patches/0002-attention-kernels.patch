+    # are dequantized inside the Flash-V100 kernels, so quantized KV is legal on
+    # CC 7.0. Without this flag the ported backend could never construct on the
+    # only hardware it was written for.
+    SM70_QUANTIZED_KV_SUPPORTED = True
+
