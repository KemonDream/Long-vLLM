+                                             int slice_tokens, int rows,
+                                             int heads) {
+  int64_t index = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+  int64_t elements = int64_t(slice_tokens) * rows;
+  if (index >= elements) {
+    return;
