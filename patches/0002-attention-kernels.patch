+    value_max = torch::stable::empty({1}, torch::headeronly::ScalarType::Float,
+                                      std::nullopt, q.device());
+    block_sum = torch::stable::empty({kRows}, torch::headeronly::ScalarType::Float,
+                                      std::nullopt, q.device());
+    block_max = torch::stable::empty({kRows}, torch::headeronly::ScalarType::Float,
+                                      std::nullopt, q.device());
+    prefix_max = torch::stable::empty({kRows}, torch::headeronly::ScalarType::Float,
+                                       std::nullopt, q.device());
+    prefix_accumulator = torch::stable::empty({kRows, kHeadDim},
+                                               torch::headeronly::ScalarType::Float,
+                                               std::nullopt, q.device());
+    max_partials = torch::stable::empty({16, kRows}, torch::headeronly::ScalarType::Float,
+                                         std::nullopt, q.device());
+    tail_max_partials = torch::stable::empty({16, kRows}, torch::headeronly::ScalarType::Float,
+                                              std::nullopt, q.device());
+    #endif
+  }
+
+  ~Sm70GqaHalf2Workspace() = default;
+};
