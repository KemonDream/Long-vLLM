+__global__ void finalize_sliced_tail(float const* numerator,
+                                     float const* inverse_sum, __half* output,
+                                     float* state_max, float* state_sum,
+                                     int output_row_start, int rows) {
+  int row = blockIdx.x;
+  int d = threadIdx.x;
+  if (row >= rows || d >= 256) {
+    return;
