+  __shared__ float shared_sum;
+  if (d == 0) {
+    shared_sum = sum;
+    state_max[global_row] = 0.0f;
+    state_sum[global_row] = sum;
+  }
+  __syncthreads();
+  output[int64_t(global_row) * 256 + d] =
+      __float2half_rn(numerator / shared_sum);
+}
