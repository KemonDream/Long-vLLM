+template <bool PagedKV, typename Tensor>
+__device__ __forceinline__ auto reshape_kv_thread_tensor(Tensor tensor) {
+  if constexpr (PagedKV) {
+    return make_tensor(tensor.data(), reshape_thread_tile(tensor.layout()));
+  } else {
+    return tensor;
+  }
+}
