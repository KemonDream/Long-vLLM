+            tmp_out.stride(1), tmp_out.stride(2), max_logits.stride(0),      \
+            max_logits.stride(1), out.stride(0), out.stride(1),              \
+            route_seq_len_begin, route_seq_len_end, route_seq_len_final);    \
+  } while (0)
