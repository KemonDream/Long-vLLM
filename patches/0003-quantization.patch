+                  stable_array_ref_eq(out.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({routes, 160})) &&
+                  stable_array_ref_eq(input.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({tokens, 2560})) &&
+                  stable_array_ref_eq(weights.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({512, 2560, 40})) &&
+                  stable_array_ref_eq(scale_codes.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({512, 160, 320})) &&
+                  stable_array_ref_eq(global_scales.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({512, 2})) &&
+                  stable_array_ref_eq(expert_ids.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({routes})),
+              "nvfp4_moe_qpn_raw_w13_swiglu_batch_sm70_out: expected exact "
+              "M4/M8/M16 Qwen3.8 tensors");
+  STD_TORCH_CHECK(input.get_device_index() == out.get_device_index() &&
+                  input.get_device_index() == weights.get_device_index() &&
+                  input.get_device_index() == scale_codes.get_device_index() &&
+                  input.get_device_index() == global_scales.get_device_index() &&
+                  input.get_device_index() == expert_ids.get_device_index(),
+              "nvfp4_moe_qpn_raw_w13_swiglu_batch_sm70_out: device mismatch");
+
+  const torch::stable::accelerator::DeviceGuard device_guard(input.get_device_index());
+#define VLLM_LAUNCH_QWEN38_RAW_W13_SWIGLU(SPLIT)                        \
+  do {                                                                  \
+    if (interleaved) {                                                  \
+      launch_nvfp4_qpn_raw_w13_swiglu_batch<SPLIT, true>(               \
+          out, input, weights, scale_codes, global_scales, expert_ids); \
+    } else {                                                            \
+      launch_nvfp4_qpn_raw_w13_swiglu_batch<SPLIT, false>(              \
+          out, input, weights, scale_codes, global_scales, expert_ids); \
+    }                                                                   \
+  } while (false)
+  if (tokens == 4) {
+    VLLM_LAUNCH_QWEN38_RAW_W13_SWIGLU(5);
+  } else if (tokens == 8) {
+    VLLM_LAUNCH_QWEN38_RAW_W13_SWIGLU(4);
+  } else {
+    VLLM_LAUNCH_QWEN38_RAW_W13_SWIGLU(1);
+  }
+#undef VLLM_LAUNCH_QWEN38_RAW_W13_SWIGLU
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void nvfp4_moe_qpn_w2_reduce_sm70_out(torch::stable::Tensor out, torch::stable::Tensor input,
