+                reference_tensors["inv_permuted_idx"],
+            ),
+            _max_diff("gate_up"),
+            _max_diff("intermediate"),
+            _max_diff("sorted_output"),
+            _max_diff("output"),
+            topk_ids_i32.detach().cpu().view(-1).tolist(),
+        )
+        self._compact_compare_reports += 1
