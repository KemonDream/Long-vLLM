+                  stable_array_ref_eq(topk_weights.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({tokens, 10})),
+              "nvfp4_moe_qpn_w2_reduce_sm70_out: expected Qwen3.8 E512/K10 "
+              "W2 tensors for 1..16 tokens");
