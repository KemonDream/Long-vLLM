+  STD_TORCH_CHECK((k / 16) % split_k == 0,
+              "nvfp4_qpn4_gemm_sm70_out: invalid split_k for K");
+  STD_TORCH_CHECK(accumulator_chains == 1 || accumulator_chains == 2,
+              "nvfp4_qpn4_gemm_sm70_out: accumulator chains must be 1 or 2");
