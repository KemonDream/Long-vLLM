+void nvfp4_moe_qpn_m1_sm70_out(torch::stable::Tensor out, torch::stable::Tensor input,
+                               torch::stable::Tensor weights, torch::stable::Tensor scales,
+                               torch::stable::Tensor expert_ids, bool broadcast_input,
+                               int64_t split_k) {
+  STD_TORCH_CHECK(out.is_cuda() && input.is_cuda() && weights.is_cuda() &&
+                  scales.is_cuda() && expert_ids.is_cuda(),
+              "nvfp4_moe_qpn_m1_sm70_out: tensors must be CUDA tensors");
+  STD_TORCH_CHECK(out.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  input.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  weights.scalar_type() == torch::headeronly::ScalarType::Int &&
+                  scales.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  expert_ids.scalar_type() == torch::headeronly::ScalarType::Int,
+              "nvfp4_moe_qpn_m1_sm70_out: dtype mismatch");
+  STD_TORCH_CHECK(out.is_contiguous() && input.is_contiguous() &&
+                  weights.is_contiguous() && scales.is_contiguous() &&
+                  expert_ids.is_contiguous(),
+              "nvfp4_moe_qpn_m1_sm70_out: tensors must be contiguous");
+  STD_TORCH_CHECK(out.dim() == 2 && input.dim() == 2 && weights.dim() == 3 &&
+                  scales.dim() == 3 && expert_ids.dim() == 1,
+              "nvfp4_moe_qpn_m1_sm70_out: rank mismatch");
+  const int64_t routes = expert_ids.numel();
+  STD_TORCH_CHECK(routes >= 10 && routes <= 160 && routes % 10 == 0 &&
+                  out.size(0) == routes && weights.size(0) == 512 &&
+                  scales.size(0) == 512,
+              "nvfp4_moe_qpn_m1_sm70_out: expected 10..160 routes in "
+              "10-route token groups and 512 experts");
+  STD_TORCH_CHECK(input.get_device_index() == out.get_device_index() &&
+                  input.get_device_index() == weights.get_device_index() &&
+                  input.get_device_index() == scales.get_device_index() &&
+                  input.get_device_index() == expert_ids.get_device_index(),
+              "nvfp4_moe_qpn_m1_sm70_out: device mismatch");
+
+  const torch::stable::accelerator::DeviceGuard device_guard(input.get_device_index());
+  const int64_t groups_k16 = input.size(1) / 16;
+  STD_TORCH_CHECK(split_k > 0 && split_k <= 32 && groups_k16 % split_k == 0,
+              "nvfp4_moe_qpn_m1_sm70_out: split_k must divide K/16");
+  const bool is_w13 = input.size(1) == 2560 && out.size(1) == 320;
+  if (is_w13) {
+    const int64_t expected_input_rows = broadcast_input ? routes / 10 : routes;
+    STD_TORCH_CHECK(
+        stable_array_ref_eq(input.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({expected_input_rows, 2560})) &&
+            stable_array_ref_eq(out.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({routes, 320})) &&
+            stable_array_ref_eq(weights.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({512, 2560, 40})) &&
+            stable_array_ref_eq(scales.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({512, 160, 320})),
+        "nvfp4_moe_qpn_m1_sm70_out: W13 tensor contract mismatch");
+  } else {
+    STD_TORCH_CHECK(!broadcast_input &&
+                    stable_array_ref_eq(input.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({routes, 160})) &&
+                    stable_array_ref_eq(out.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({routes, 2560})) &&
+                    stable_array_ref_eq(weights.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({512, 160, 320})) &&
+                    stable_array_ref_eq(scales.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({512, 10, 2560})),
+                "nvfp4_moe_qpn_m1_sm70_out: W2 tensor contract mismatch");
+  }
+  dispatch_nvfp4_qpn_m1(out, input, weights, scales, expert_ids,
+                        broadcast_input, split_k);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
