+                  topk_ids.is_contiguous() &&
+                  topk_ids.numel() == kGlm53MoeQ8Slots,
+              "sm70_glm53_moe_permute_q8_out: topk_ids must be contiguous "
+              "CUDA int32 [8, 8].");
