+inline void awq_meta_put(torch::stable::Tensor& meta, int64_t idx, int64_t value) {
+  auto ptr = meta.mutable_data_ptr<int64_t>();
+  if (meta.device().is_cpu()) {
+    ptr[idx] = value;
+  } else {
+    cudaMemcpyAsync(ptr + idx, &value, sizeof(value), cudaMemcpyHostToDevice,
+                    get_current_cuda_stream());
