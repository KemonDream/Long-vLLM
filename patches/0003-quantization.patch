+                                   torch::stable::Tensor sorted_row_idx,
+                                   torch::stable::Tensor inv_permuted_idx,
+                                   torch::stable::Tensor compact_offsets,
+                                   torch::stable::Tensor active_expert_ids) {
+  STD_TORCH_CHECK(input.is_cuda() && input.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  input.is_contiguous() &&
+                  stable_array_ref_eq(input.sizes(),
