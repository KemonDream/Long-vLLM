+std::vector<torch::stable::Tensor> awq_sm70_prepare_impl(
+    torch::stable::Tensor qweight, torch::stable::Tensor scales, torch::stable::Tensor qzeros,
+    int64_t group_size, bool interleave_gated_silu, bool compact_metadata) {
+  validate_awq_inputs(qweight, scales, qzeros);
+
+  qweight = torch::stable::contiguous(qweight);
+  scales = torch::stable::contiguous(scales);
+  qzeros = torch::stable::contiguous(qzeros);
+
+  const torch::stable::accelerator::DeviceGuard device_guard(qweight.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream();
+
+  const int64_t k = qweight.size(0);
+  const int64_t n = qweight.size(1) * 8;
+  const int64_t num_groups = scales.size(0);
+
+  STD_TORCH_CHECK(scales.size(1) == n, "awq_sm70_prepare: scales shape mismatch.");
+  STD_TORCH_CHECK(qzeros.size(0) == num_groups,
+              "awq_sm70_prepare: qzeros group mismatch.");
+  STD_TORCH_CHECK(qzeros.size(1) * 8 == n,
+              "awq_sm70_prepare: qzeros shape mismatch.");
+  STD_TORCH_CHECK(k % 8 == 0 && n % 8 == 0,
+              "awq_sm70_prepare: K and N must be multiples of 8.");
+  STD_TORCH_CHECK(k % num_groups == 0,
+              "awq_sm70_prepare: input dim must be divisible by groups.");
+
+  if (group_size <= 0) {
+    group_size = k / num_groups;
+  }
+  STD_TORCH_CHECK(k / num_groups == group_size,
+              "awq_sm70_prepare: group_size mismatch with scales.");
+  STD_TORCH_CHECK(group_size == 32 || group_size == 64 || group_size == 128,
+              "awq_sm70_prepare: SM70 AWQ supports group_size=32/64/128, got ",
+              group_size, ".");
+
+  const bool grouped = (group_size != k);
+  const auto converters = turbomind::gemm::GetConverters(
+      turbomind::kHalf, turbomind::kUint4, turbomind::kHalf, grouped, 70);
+  const auto* conv_w = converters[0];
+  const auto* conv_s = converters[1];
+  STD_TORCH_CHECK(conv_w && conv_s,
+              "awq_sm70_prepare: no compatible TurboMind converters.");
+
+  const auto order_w = conv_w->order;
+  const bool is_A_w = turbomind::gemm::get_operand_tag(conv_w->pack) ==
+                      turbomind::gemm::OPERAND_A;
+  const bool is_B_w = !is_A_w;
+
+  auto packed_weight = torch::stable::empty_like(qweight);
+  turbomind::unpack_awq_gemm(
+      reinterpret_cast<turbomind::uint4_t*>(packed_weight.mutable_data_ptr<int>()),
+      reinterpret_cast<const turbomind::uint4_t*>(qweight.const_data_ptr<int>()),
+      static_cast<int>(k), static_cast<int>(n), stream);
+
+  auto tmp_u16 = torch::stable::empty(
+      {k, n}, torch::headeronly::ScalarType::Short, std::nullopt,
+      qweight.device());
+  turbomind::extend_to_u16(
+      reinterpret_cast<uint16_t*>(tmp_u16.mutable_data_ptr<int16_t>()),
+      reinterpret_cast<const turbomind::uint4_t*>(
+          packed_weight.const_data_ptr<int>()),
+      tmp_u16.numel(), stream);
+  if (interleave_gated_silu) {
+    tmp_u16 = interleave_gated_silu_cols(tmp_u16);
+  }
+
+  torch::stable::Tensor tmp_u16_conv = tmp_u16;
+  if (order_w == turbomind::gemm::kRowMajor) {
+    tmp_u16_conv = torch::stable::contiguous(torch::stable::transpose(tmp_u16, 0, 1));
+  }
+
+  turbomind::gemm::MatrixLayout w_desc{
+      turbomind::kHalf,
+      order_w,
+      static_cast<int>(n),
+      static_cast<int>(k),
+      order_w == turbomind::gemm::kRowMajor ? static_cast<int>(k)
+                                            : static_cast<int>(n),
+  };
+
+  if (is_B_w) {
+    std::swap(w_desc.rows, w_desc.cols);
+    w_desc.order = ~w_desc.order;
+  }
+
+  turbomind::gemm::MatrixLayout k_desc = w_desc;
+  k_desc.type = turbomind::data_type_v<turbomind::uint4_t>;
+  k_desc.pack = conv_w->pack;
+  if (is_A_w) {
+    k_desc = turbomind::gemm::transpose(k_desc);
+  }
+
+  auto tm_weight = torch::stable::empty_like(qweight);
+  STD_TORCH_CHECK(conv_w->Convert(tmp_u16_conv.data_ptr(), w_desc,
+                              tm_weight.data_ptr(), k_desc, stream) == 0,
+              "awq_sm70_prepare: weight conversion failed.");
+
+  // Unpack AWQ zeros using PyTorch tensor ops (matches lmdeploy's Python
+  // approach).  The C++ unpack_awq_gemm() requires rows%8==0 which fails
+  // when num_groups < 8 (e.g. Qwen3-30B-A3B w2: K=768, num_groups=6).
+  // Unpack 4-bit AWQ zero-points on the host (the stable ABI lacks bitwise
+  // tensor ops); the result feeds TurboMind U-operand packing.
+  const int awq_order[] = {0, 4, 1, 5, 2, 6, 3, 7};
+  auto zeros_u8 = torch::stable::empty({num_groups, n},
+                                         torch::headeronly::ScalarType::Byte,
+                                         std::nullopt, qzeros.device());
+  {
+    auto qc = torch::stable::to(qzeros, std::nullopt, std::nullopt,
+                                 torch::stable::Device(torch::headeronly::DeviceType::CPU));
+    const uint8_t* zb = qc.const_data_ptr<uint8_t>();
+    const int64_t bpr = qzeros.size(1);
+    std::vector<uint8_t> buf(static_cast<size_t>(num_groups) * static_cast<size_t>(n));
+    for (int64_t r = 0; r < num_groups; ++r) {
+      for (int64_t j = 0; j < bpr; ++j) {
+        const uint8_t v = zb[r * bpr + j];
+        for (int k = 0; k < 8; ++k) {
+          const int m = awq_order[k];
+          const uint8_t val = (m < 4) ? (v & 0x0Fu)
+                                       : ((v >> (4 * (m - 4))) & 0x0Fu);
+          buf[static_cast<size_t>(r) * n + j * 8 + k] = val;
+        }
+      }
+    }
+    cudaMemcpy(zeros_u8.mutable_data_ptr<uint8_t>(), buf.data(), buf.size(),
+               cudaMemcpyHostToDevice);
+  }
+  if (interleave_gated_silu) {
+    scales = interleave_gated_silu_cols(scales);
+    zeros_u8 = interleave_gated_silu_cols(zeros_u8);
+  }
+
+  torch::stable::Tensor source_stats;
+  if (compact_metadata) {
+    source_stats = torch::stable::empty({num_groups, n},
+                                           torch::headeronly::ScalarType::Int, std::nullopt,
+                                           scales.device());
+    constexpr int kThreads = 256;
+    const int blocks =
+        static_cast<int>((scales.numel() + kThreads - 1) / kThreads);
+    pack_awq_compact_source_kernel<<<blocks, kThreads, 0, stream>>>(
+        source_stats.mutable_data_ptr<uint32_t>(),
+        reinterpret_cast<const half*>(scales.const_data_ptr<half>()),
+        zeros_u8.const_data_ptr<uint8_t>(), scales.numel());
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+  } else {
+    auto zeros_half = torch::stable::to(zeros_u8, torch::headeronly::ScalarType::Half,
+                                          std::nullopt, zeros_u8.device());
+    source_stats = torch::stable::empty({num_groups, n * 2},
+                                           torch::headeronly::ScalarType::Half, std::nullopt,
+                                           scales.device());
+    turbomind::fuse_scales_and_zeros(
+        source_stats.mutable_data_ptr<half>(),
+        reinterpret_cast<const half*>(scales.const_data_ptr<half>()),
+        zeros_half.mutable_data_ptr<half>(),
+        scales.numel(), stream);
+  }
+
+  const auto order_s = conv_s->order;
+  const bool is_A_s = turbomind::gemm::get_operand_tag(conv_s->pack) ==
+                      turbomind::gemm::OPERAND_U;
+  const bool is_B_s = !is_A_s;
+
+  turbomind::gemm::MatrixLayout s_desc{
+      turbomind::kUint32,  order_s,
+      static_cast<int>(n), static_cast<int>(num_groups),
+      static_cast<int>(n),
+  };
+  if (is_B_s) {
+    std::swap(s_desc.rows, s_desc.cols);
+    s_desc.order = ~s_desc.order;
+  }
+
+  turbomind::gemm::MatrixLayout q_desc = s_desc;
+  q_desc.pack = conv_s->pack;
+  if (is_A_s) {
+    q_desc = turbomind::gemm::transpose(q_desc);
+  }
+
+  auto tm_stats = torch::stable::empty({num_groups, n},
+                                         torch::headeronly::ScalarType::Int, std::nullopt,
+                                         scales.device());
+  STD_TORCH_CHECK(conv_s->Convert(source_stats.data_ptr(), s_desc,
+                              tm_stats.data_ptr(), q_desc, stream) == 0,
+              "awq_sm70_prepare: scale conversion failed.");
+
+  torch::stable::Tensor tm_scales = tm_stats;
+  if (compact_metadata) {
+    tm_scales = torch::stable::empty({num_groups, n, 3},
+                                        torch::headeronly::ScalarType::Byte, std::nullopt,
+                                        scales.device());
+    constexpr int kThreads = 256;
+    const int blocks =
+        static_cast<int>((tm_stats.numel() + kThreads - 1) / kThreads);
+    compact_awq_stats_kernel<<<blocks, kThreads, 0, stream>>>(
+        tm_scales.mutable_data_ptr<uint8_t>(),
+        reinterpret_cast<const uint32_t*>(tm_stats.const_data_ptr<int32_t>()),
+        tm_stats.numel());
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+  }
+
+  auto meta = torch::stable::empty({2}, torch::headeronly::ScalarType::Long, std::nullopt,
+                                    torch::stable::Device(torch::headeronly::DeviceType::CPU));
+  awq_meta_put(meta, 0, k_desc.ld);  // q_ld is an internal contract between prepare, pointer construction and
+  // the SM70 iterator.  Its sign distinguishes compact 3-byte statistics;
+  // the magnitude remains the logical TurboMind leading dimension.
+  awq_meta_put(meta, 1, compact_metadata ? -q_desc.ld : q_desc.ld);
+  return {tm_weight, tm_scales, meta};
+}
+
+std::vector<torch::stable::Tensor> awq_sm70_prepare(torch::stable::Tensor qweight,
+                                            torch::stable::Tensor scales,
+                                            torch::stable::Tensor qzeros,
+                                            int64_t group_size,
+                                            bool interleave_gated_silu) {
+  return awq_sm70_prepare_impl(qweight, scales, qzeros, group_size,
+                               interleave_gated_silu, false);
+}
+
+std::vector<torch::stable::Tensor> awq_sm70_prepare_compact(
+    torch::stable::Tensor qweight, torch::stable::Tensor scales, torch::stable::Tensor qzeros,
+    int64_t group_size, bool interleave_gated_silu) {
+  return awq_sm70_prepare_impl(qweight, scales, qzeros, group_size,
+                               interleave_gated_silu, true);
+}
+
+std::vector<torch::stable::Tensor> uint4_sm70_prepare(torch::stable::Tensor qweight,
+                                              torch::stable::Tensor scales,
+                                              torch::stable::Tensor zeros,
+                                              int64_t group_size,
+                                              bool interleave_gated_silu) {
+  constexpr const char* op_name = "uint4_sm70_prepare";
+  validate_uint4_inputs(qweight, scales, zeros, op_name);
+
+  qweight = torch::stable::contiguous(qweight);
+  scales = torch::stable::contiguous(scales);
+  zeros = torch::stable::contiguous(zeros);
+
+  const torch::stable::accelerator::DeviceGuard device_guard(qweight.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream();
+
+  const int64_t k = qweight.size(0);
+  const int64_t n = qweight.size(1);
+  const int64_t num_groups = scales.size(0);
+
+  STD_TORCH_CHECK(scales.size(1) == n, op_name, ": scales shape mismatch.");
+  STD_TORCH_CHECK(zeros.size(0) == num_groups, op_name, ": zeros group mismatch.");
+  STD_TORCH_CHECK(zeros.size(1) == n, op_name, ": zeros shape mismatch.");
+  STD_TORCH_CHECK(k % 8 == 0 && n % 8 == 0, op_name,
+              ": K and N must be multiples of 8.");
+  STD_TORCH_CHECK(num_groups > 0 && k % num_groups == 0, op_name,
+              ": input dim must be divisible by groups.");
+
+  if (group_size <= 0) {
+    group_size = k / num_groups;
+  }
+  STD_TORCH_CHECK(k / num_groups == group_size, op_name,
+              ": group_size mismatch with scales.");
+  STD_TORCH_CHECK(group_size == 32 || group_size == 64 || group_size == 128,
+              op_name, ": SM70 uint4 supports group_size=32/64/128, got ",
+              group_size, ".");
+
+  const bool grouped = (group_size != k);
+  const auto converters = turbomind::gemm::GetConverters(
+      turbomind::kHalf, turbomind::kUint4, turbomind::kHalf, grouped, 70);
+  const auto* conv_w = converters[0];
+  const auto* conv_s = converters[1];
+  STD_TORCH_CHECK(conv_w && conv_s, op_name,
+              ": no compatible TurboMind converters.");
+
+  const auto order_w = conv_w->order;
+  const bool is_A_w = turbomind::gemm::get_operand_tag(conv_w->pack) ==
+                      turbomind::gemm::OPERAND_A;
+  const bool is_B_w = !is_A_w;
+
+  auto tmp_u16 = torch::stable::empty(
+      {k, n}, torch::headeronly::ScalarType::Short, std::nullopt,
+      qweight.device());
+  turbomind::extend_to_u16(
+      reinterpret_cast<uint16_t*>(tmp_u16.mutable_data_ptr<int16_t>()),
+      reinterpret_cast<const uint8_t*>(qweight.data_ptr()), tmp_u16.numel(),
+      stream);
+  if (interleave_gated_silu) {
+    tmp_u16 = interleave_gated_silu_cols(tmp_u16);
+  }
+
+  torch::stable::Tensor tmp_u16_conv = tmp_u16;
+  if (order_w == turbomind::gemm::kRowMajor) {
+    tmp_u16_conv = torch::stable::contiguous(torch::stable::transpose(tmp_u16, 0, 1));
+  }
+
+  turbomind::gemm::MatrixLayout w_desc{
+      turbomind::kHalf,
+      order_w,
+      static_cast<int>(n),
+      static_cast<int>(k),
+      order_w == turbomind::gemm::kRowMajor ? static_cast<int>(k)
+                                            : static_cast<int>(n),
+  };
+  if (is_B_w) {
+    std::swap(w_desc.rows, w_desc.cols);
+    w_desc.order = ~w_desc.order;
+  }
+
+  turbomind::gemm::MatrixLayout k_desc = w_desc;
+  k_desc.type = turbomind::data_type_v<turbomind::uint4_t>;
+  k_desc.pack = conv_w->pack;
+  if (is_A_w) {
+    k_desc = turbomind::gemm::transpose(k_desc);
+  }
+
+  auto tm_weight = torch::stable::empty({k, n / 8},
+                                          torch::headeronly::ScalarType::Int, std::nullopt,
+                                          qweight.device());
+  STD_TORCH_CHECK(conv_w->Convert(tmp_u16_conv.data_ptr(), w_desc,
+                              tm_weight.data_ptr(), k_desc, stream) == 0,
+              op_name, ": weight conversion failed.");
+
+  if (interleave_gated_silu) {
+    scales = interleave_gated_silu_cols(scales);
+    zeros = interleave_gated_silu_cols(zeros);
+  }
+
+  auto fused = torch::stable::empty({num_groups, n * 2},
+                                      torch::headeronly::ScalarType::Half, std::nullopt,
+                                      scales.device());
+  turbomind::fuse_scales_and_zeros(
+      fused.mutable_data_ptr<half>(),
+      reinterpret_cast<const half*>(scales.const_data_ptr<half>()),
+      zeros.mutable_data_ptr<half>(), scales.numel(),
+      stream);
+
+  const auto order_s = conv_s->order;
+  const bool is_A_s = turbomind::gemm::get_operand_tag(conv_s->pack) ==
+                      turbomind::gemm::OPERAND_U;
+  const bool is_B_s = !is_A_s;
+
+  turbomind::gemm::MatrixLayout s_desc{
+      turbomind::kUint32,  order_s,
+      static_cast<int>(n), static_cast<int>(num_groups),
+      static_cast<int>(n),
+  };
+  if (is_B_s) {
+    std::swap(s_desc.rows, s_desc.cols);
+    s_desc.order = ~s_desc.order;
+  }
+
+  turbomind::gemm::MatrixLayout q_desc = s_desc;
+  q_desc.pack = conv_s->pack;
+  if (is_A_s) {
+    q_desc = turbomind::gemm::transpose(q_desc);
+  }
+
+  auto tm_scales = torch::stable::empty({num_groups, n},
+                                          torch::headeronly::ScalarType::Int, std::nullopt,
+                                          scales.device());
+  STD_TORCH_CHECK(conv_s->Convert(fused.data_ptr(), s_desc, tm_scales.data_ptr(),
+                              q_desc, stream) == 0,
+              op_name, ": scale conversion failed.");
+
+  auto meta = torch::stable::empty({2}, torch::headeronly::ScalarType::Long, std::nullopt,
+                                    torch::stable::Device(torch::headeronly::DeviceType::CPU));
+  awq_meta_put(meta, 0, k_desc.ld);
+  awq_meta_put(meta, 1, q_desc.ld);
+  return {tm_weight, tm_scales, meta};
+}
+
+std::vector<torch::stable::Tensor> fp8_sm70_prepare(torch::stable::Tensor qweight,
+                                            torch::stable::Tensor scales,
+                                            int64_t group_size,
+                                            bool interleave_gated_silu) {
+  validate_fp8_inputs(qweight, scales, group_size);
+
+  qweight = torch::stable::contiguous(qweight);
+  scales = torch::stable::contiguous(scales);
+
+  const torch::stable::accelerator::DeviceGuard device_guard(qweight.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream();
+
+  const int64_t n = qweight.size(0);
+  const int64_t k = qweight.size(1);
+  STD_TORCH_CHECK(k % 8 == 0 && n % 8 == 0,
+              "fp8_sm70_prepare: K and N must be multiples of 8.");
+  const bool channelwise_scales = scales.size(0) == n && scales.size(1) == 1;
+  const bool blockwise_scales =
+      scales.size(0) == (n + group_size - 1) / group_size &&
+      scales.size(1) == (k + group_size - 1) / group_size;
+  STD_TORCH_CHECK(channelwise_scales || blockwise_scales,
+              "fp8_sm70_prepare: expected [N, 1] channel scales or "
+              "[ceil(N/128), ceil(K/128)] block scales.");
+
+  const auto converters = turbomind::gemm::GetConverters(
+      turbomind::kHalf, turbomind::kFloat8_e4m3, turbomind::kHalf, true, 70);
+  const auto* conv_w = converters[0];
+  const auto* conv_s = converters[1];
+  STD_TORCH_CHECK(conv_w && conv_s,
+              "fp8_sm70_prepare: no compatible TurboMind converters.");
+
+  const auto order_w = conv_w->order;
+  const bool is_A_w = turbomind::gemm::get_operand_tag(conv_w->pack) ==
+                      turbomind::gemm::OPERAND_A;
+  const bool is_B_w = !is_A_w;
+
+  auto qweight_kn = torch::stable::contiguous(torch::stable::transpose(qweight, 0, 1));
+  auto tmp_u16 = torch::stable::empty({k, n}, torch::headeronly::ScalarType::Short,
+                                       std::nullopt, qweight.device());
+  turbomind::extend_to_u16(
+      reinterpret_cast<uint16_t*>(tmp_u16.mutable_data_ptr<int16_t>()),
+      reinterpret_cast<const uint8_t*>(qweight_kn.data_ptr()), tmp_u16.numel(),
+      stream);
+  if (interleave_gated_silu) {
+    tmp_u16 = interleave_gated_silu_cols(tmp_u16);
+  }
+
+  torch::stable::Tensor tmp_u16_conv = tmp_u16;
+  if (order_w == turbomind::gemm::kRowMajor) {
+    tmp_u16_conv = torch::stable::contiguous(torch::stable::transpose(tmp_u16, 0, 1));
+  }
+
+  turbomind::gemm::MatrixLayout w_desc{
+      turbomind::kHalf,
+      order_w,
+      static_cast<int>(n),
+      static_cast<int>(k),
+      order_w == turbomind::gemm::kRowMajor ? static_cast<int>(k)
+                                            : static_cast<int>(n),
+  };
+  if (is_B_w) {
+    std::swap(w_desc.rows, w_desc.cols);
+    w_desc.order = ~w_desc.order;
+  }
+
+  turbomind::gemm::MatrixLayout k_desc = w_desc;
+  k_desc.type = turbomind::data_type_v<uint8_t>;
+  k_desc.pack = conv_w->pack;
+  if (is_A_w) {
+    k_desc = turbomind::gemm::transpose(k_desc);
+  }
+
+  auto tm_weight = torch::stable::empty({k, n},
+                                          torch::headeronly::ScalarType::Byte, std::nullopt,
+                                          qweight.device());
+  STD_TORCH_CHECK(conv_w->Convert(tmp_u16_conv.data_ptr(), w_desc,
+                              tm_weight.data_ptr(), k_desc, stream) == 0,
+              "fp8_sm70_prepare: weight conversion failed.");
+
+  const auto order_s = conv_s->order;
+  const bool is_A_s = turbomind::gemm::get_operand_tag(conv_s->pack) ==
+                      turbomind::gemm::OPERAND_U;
+  const bool is_B_s = !is_A_s;
+  const int64_t num_groups = (k + group_size - 1) / group_size;
+
+  torch::stable::Tensor group_scales;
+  auto st = torch::stable::contiguous(torch::stable::transpose(scales, 0, 1));
+  auto st_h = torch::stable::to(st, torch::headeronly::ScalarType::Half,
+                                 std::nullopt, st.device());
+  const int64_t gs_rows = st_h.size(0);
+  const int64_t gs_cols = st_h.size(1);
+  if (channelwise_scales) {
+    auto rep = torch::stable::empty({gs_rows * num_groups, gs_cols},
+                                     torch::headeronly::ScalarType::Half,
+                                     std::nullopt, st_h.device());
+    for (int64_t blk = 0; blk < num_groups; ++blk) {
+      for (int64_t ri = 0; ri < gs_rows; ++ri) {
+        auto row_rep = torch::stable::select(rep, 0, blk * gs_rows + ri);
+        torch::stable::copy_(row_rep, torch::stable::select(st_h, 0, ri));
+      }
+    }
+    group_scales = torch::stable::contiguous(rep);
+  } else {
+    auto repi = torch::stable::empty({gs_rows * group_size, gs_cols},
+                                      torch::headeronly::ScalarType::Half,
+                                      std::nullopt, st_h.device());
+    for (int64_t r = 0; r < gs_rows; ++r) {
+      for (int64_t jj = 0; jj < group_size; ++jj) {
+        auto row_repi = torch::stable::select(repi, 0, r * group_size + jj);
+        torch::stable::copy_(row_repi, torch::stable::select(st_h, 0, r));
+      }
+    }
+    group_scales = torch::stable::contiguous(torch::stable::narrow(repi, 1, 0, n));
+  }
+  if (interleave_gated_silu) {
+    group_scales = interleave_gated_silu_cols(group_scales);
+  }
+
+  turbomind::gemm::MatrixLayout s_desc{
+      turbomind::kUint16,  order_s,
+      static_cast<int>(n), static_cast<int>(num_groups),
+      static_cast<int>(n),
+  };
+  if (is_B_s) {
+    std::swap(s_desc.rows, s_desc.cols);
+    s_desc.order = ~s_desc.order;
+  }
+
+  turbomind::gemm::MatrixLayout q_desc = s_desc;
+  q_desc.pack = conv_s->pack;
+  if (is_A_s) {
+    q_desc = turbomind::gemm::transpose(q_desc);
+  }
+
+  auto tm_scales = torch::stable::empty_like(group_scales);
+  STD_TORCH_CHECK(conv_s->Convert(group_scales.data_ptr(), s_desc,
+                              tm_scales.data_ptr(), q_desc, stream) == 0,
+              "fp8_sm70_prepare: scale conversion failed.");
+
+  auto meta = torch::stable::empty({2}, torch::headeronly::ScalarType::Long, std::nullopt,
+                                    torch::stable::Device(torch::headeronly::DeviceType::CPU));
+  awq_meta_put(meta, 0, k_desc.ld);
+  awq_meta_put(meta, 1, q_desc.ld);
+  return {tm_weight, tm_scales, meta};
+}
