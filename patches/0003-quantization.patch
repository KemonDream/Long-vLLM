+template <int kSplitK>
+void launch_mxfp4_qpn_m1(torch::stable::Tensor out, torch::stable::Tensor input,
+                         torch::stable::Tensor weights, torch::stable::Tensor scales,
+                         torch::stable::Tensor expert_ids, bool broadcast_input) {
+  const int n = static_cast<int>(out.size(1));
+  const int k = static_cast<int>(input.size(1));
+  mxfp4_qpn_m1_sm70_kernel<kSplitK>
+      <<<dim3(n / 32, 6), 32 * kSplitK, 0, get_current_cuda_stream()>>>(
+          reinterpret_cast<const half*>(input.const_data_ptr<half>()),
+          reinterpret_cast<const uint32_t*>(weights.const_data_ptr<int32_t>()),
+          scales.const_data_ptr<uint8_t>(), expert_ids.const_data_ptr<int32_t>(),
+          reinterpret_cast<half*>(out.mutable_data_ptr<half>()), n, k,
+          broadcast_input);
+}
