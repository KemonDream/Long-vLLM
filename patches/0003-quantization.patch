+            )
+        if fast_prefill:
+            logger.info_once(
+                "SM70 Qwen3.8 NVFP4 fast grouped prefill enabled "
+                "(zero-copy W13 N256+N64, cached-B W2)."
+            )
+        if glm53_fused_permute_q8:
