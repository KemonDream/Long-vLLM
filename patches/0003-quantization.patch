+  STD_TORCH_CHECK(in_feats.scalar_type() == torch::headeronly::ScalarType::Half,
+              "nvfp4_gemm_sm70: input must be float16.");
+  STD_TORCH_CHECK(tm_weight.scalar_type() == torch::headeronly::ScalarType::Int,
+              "nvfp4_gemm_sm70: weight must be int32.");
