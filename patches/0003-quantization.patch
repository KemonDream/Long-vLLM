+                layer.sm70_num_experts,
+                layer.sm70_w13_k_dim,
+                layer.sm70_w13_n_dim,
+                self.group_size,
+                False,
+            )
+        elif route_plan.w13 == Sm70MoeStageRoute.BATCHED:
