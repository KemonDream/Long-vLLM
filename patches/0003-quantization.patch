+    VLLM_NVFP4_QPN_M1_CASE(4);
+    VLLM_NVFP4_QPN_M1_CASE(5);
+    VLLM_NVFP4_QPN_M1_CASE(8);
+    VLLM_NVFP4_QPN_M1_CASE(10);
