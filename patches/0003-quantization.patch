+torch::stable::Tensor awq_moe_gemm_sm70(torch::stable::Tensor sorted_input,
+                                torch::stable::Tensor expert_offsets,
+                                torch::stable::Tensor strided_ptrs_w,
+                                torch::stable::Tensor strided_ptrs_s,
+                                int64_t num_experts, int64_t k, int64_t n,
+                                int64_t group_size) {
+  auto out = torch::stable::empty({sorted_input.size(0), n}, sorted_input.scalar_type(),
+                                   std::nullopt, sorted_input.device());
+  awq_moe_gemm_sm70_out(out, sorted_input, expert_offsets, strided_ptrs_w,
+                        strided_ptrs_s, num_experts, k, n, group_size, false);
+  return out;
+}
