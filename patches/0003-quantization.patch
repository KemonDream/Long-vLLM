+        chunk_expert_offsets.mutable_data_ptr<int>(), chunk_range_begin.mutable_data_ptr<int>(),
+        chunk_range_end.mutable_data_ptr<int>(), static_cast<int>(num_experts),
+        static_cast<int>(source_begin), static_cast<int>(source_end));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+
+    awq_moe_prefix_chunk_offsets_kernel<<<1, 1, 0, stream>>>(
+        chunk_expert_offsets.mutable_data_ptr<int>(), static_cast<int>(num_experts));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+
+    awq_moe_fill_chunk_indices_kernel<<<num_experts, kThreads, 0, stream>>>(
+        permuted_idx.const_data_ptr<int>(), chunk_expert_offsets.const_data_ptr<int>(),
+        chunk_range_begin.const_data_ptr<int>(), chunk_range_end.const_data_ptr<int>(),
+        chunk_a_indices.mutable_data_ptr<int>(), chunk_inv_permuted_idx.mutable_data_ptr<int>(),
+        static_cast<int>(source_begin));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
