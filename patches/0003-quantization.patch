+    awq_moe_chunk_weighted_reduce_kernel<<<current_tokens, kThreads, 0,
+                                           stream>>>(
+        out.mutable_data_ptr<__half>(),
+        chunk_output.const_data_ptr<__half>(),
+        topk_weights.const_data_ptr<float>(), chunk_inv_permuted_idx.const_data_ptr<int>(),
