+    awq_moe_gemm_sm70_out_impl(
+        torch::stable::narrow(chunk_output, 0, 0, current_slots), input, chunk_expert_offsets,
+        ptrs_w, ptrs_s, num_experts, k, n, group_size, false, torch::stable::Tensor(),
+        false, torch::stable::Tensor(), torch::stable::Tensor(), false, current_slots,
+        chunk_a_indices);
