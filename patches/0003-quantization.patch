+                    )
+                    _silu_and_mul_w13(layer, strict_intermediate, strict_gate_up)
+                    sm70_ops.awq_moe_single_token_dense_stage_sm70_out(
+                        strict_sorted_output,
+                        strict_intermediate,
+                        strict_expert_offsets,
+                        strict_sorted_expert_ids,
+                        layer.w2_strided_ptrs_w,
