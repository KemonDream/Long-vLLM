+  STD_TORCH_CHECK(static_cast<int>(topk_weights.numel()) == top_k,
+              "fp8_moe_single_token_sm70_out: topk_weights size mismatch.");
+  STD_TORCH_CHECK(compact_input.dim() == 2 && compact_input.size(0) == top_k &&
+                  compact_input.size(1) == x.size(1),
+              "fp8_moe_single_token_sm70_out: compact_input shape mismatch.");
+  STD_TORCH_CHECK(gate_up.dim() == 2 && gate_up.size(0) == top_k &&
+                  gate_up.size(1) == w13_n,
+              "fp8_moe_single_token_sm70_out: gate_up shape mismatch.");
+  STD_TORCH_CHECK(intermediate.dim() == 2 && intermediate.size(0) == top_k &&
+                  intermediate.size(1) == w13_n / 2,
+              "fp8_moe_single_token_sm70_out: intermediate shape mismatch.");
+  STD_TORCH_CHECK(sorted_output.dim() == 2 && sorted_output.size(0) == top_k &&
+                  sorted_output.size(1) == w2_n,
+              "fp8_moe_single_token_sm70_out: sorted_output shape mismatch.");
+  STD_TORCH_CHECK(sorted_weights.numel() == top_k,
+              "fp8_moe_single_token_sm70_out: sorted_weights size mismatch.");
+  const int64_t source_num_experts = src_w13_ptrs_w_rows.size(0);
+  STD_TORCH_CHECK(
+      source_num_experts > 0,
+      "fp8_moe_single_token_sm70_out: source expert count must be positive.");
+  const int64_t expected_offsets =
+      exact_per_route ? source_num_experts + 1 : top_k + 1;
+  STD_TORCH_CHECK(expert_offsets.numel() == expected_offsets,
+              "fp8_moe_single_token_sm70_out: expert_offsets size mismatch.");
+  STD_TORCH_CHECK(inv_permuted_idx.numel() == top_k,
+              "fp8_moe_single_token_sm70_out: inv_permuted_idx size mismatch.");
+  STD_TORCH_CHECK(
+      sorted_expert_ids.numel() >= top_k && sorted_expert_ids.is_contiguous(),
+      "fp8_moe_single_token_sm70_out: sorted expert ids must be contiguous and "
+      "large enough.");
+  if (broadcast_input && broadcast_input_indices.numel() > 0) {
+    STD_TORCH_CHECK(broadcast_input_indices.numel() >= top_k,
+                "fp8_moe_single_token_sm70_out: broadcast input indices size "
+                "mismatch.");
+  }
+  if (w2_direct_reduce) {
+    STD_TORCH_CHECK(!fused_weighted_reduce,
+                "fp8_moe_single_token_sm70_out: W2 direct reduce conflicts "
+                "with weighted-reduce epilogue.");
+    STD_TORCH_CHECK(w2_raw_weight.defined() && w2_raw_scale_inv.defined(),
+                "fp8_moe_single_token_sm70_out: W2 direct reduce requires raw "
+                "W2 tensors.");
+  }
+  if (indexed_expert_ptrs) {
+    STD_TORCH_CHECK(src_w13_ptrs_w_rows.is_contiguous() &&
+                    src_w13_ptrs_s_rows.is_contiguous() &&
+                    src_w2_ptrs_w_rows.is_contiguous() &&
+                    src_w2_ptrs_s_rows.is_contiguous(),
+                "fp8_moe_single_token_sm70_out: indexed expert ptrs require "
+                "contiguous source ptr rows.");
+  }
+  if (exact_per_route) {
+    STD_TORCH_CHECK(!fused_gated_silu && !fused_weighted_reduce &&
+                    !broadcast_input && !w2_direct_reduce,
+                "fp8_moe_single_token_sm70_out: exact per-route mode only "
+                "supports the unfused compact path.");
+    STD_TORCH_CHECK(src_w13_ptrs_w_rows.is_contiguous() &&
+                    src_w13_ptrs_s_rows.is_contiguous() &&
+                    src_w2_ptrs_w_rows.is_contiguous() &&
+                    src_w2_ptrs_s_rows.is_contiguous(),
+                "fp8_moe_single_token_sm70_out: exact per-route mode requires "
+                "contiguous source ptr rows.");
+  }
+  const int64_t row_bytes = src_w13_ptrs_w_rows.size(1);
+  STD_TORCH_CHECK(
+      src_w13_ptrs_w_rows.dim() == 2 && src_w13_ptrs_s_rows.dim() == 2 &&
+          src_w2_ptrs_w_rows.dim() == 2 && src_w2_ptrs_s_rows.dim() == 2 &&
+          dst_w13_ptrs_w_rows.dim() == 2 && dst_w13_ptrs_s_rows.dim() == 2 &&
+          dst_w2_ptrs_w_rows.dim() == 2 && dst_w2_ptrs_s_rows.dim() == 2,
+      "fp8_moe_single_token_sm70_out: ptr row tensors must be 2D.");
+  STD_TORCH_CHECK(
+      dst_w13_ptrs_w_rows.size(0) == top_k &&
+          dst_w13_ptrs_s_rows.size(0) == top_k &&
+          dst_w2_ptrs_w_rows.size(0) == top_k &&
+          dst_w2_ptrs_s_rows.size(0) == top_k &&
+          dst_w13_ptrs_w_rows.size(1) == row_bytes &&
+          dst_w13_ptrs_s_rows.size(1) == row_bytes &&
+          dst_w2_ptrs_w_rows.size(1) == row_bytes &&
+          dst_w2_ptrs_s_rows.size(1) == row_bytes,
+      "fp8_moe_single_token_sm70_out: destination ptr row shapes mismatch.");
+
+  const torch::stable::accelerator::DeviceGuard device_guard(x.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream();
+  const int src_row_stride = static_cast<int>(src_w13_ptrs_w_rows.stride(0));
+  const int dst_row_stride = static_cast<int>(dst_w13_ptrs_w_rows.stride(0));
+  const bool vectorized_prepare = sm70_fp8_moe_prepare_vec_enabled();
+  const bool prepare_sorted_weight_copy =
+      fused_weighted_reduce || !vectorized_prepare;
+  const float* prepare_topk_weights =
+      prepare_sorted_weight_copy ? topk_weights.const_data_ptr<float>() : nullptr;
+  float* prepare_sorted_weights =
+      prepare_sorted_weight_copy ? sorted_weights.mutable_data_ptr<float>() : nullptr;
+  constexpr int kThreads = 256;
+  const bool copy_expert_ptr_rows = !indexed_expert_ptrs && !exact_per_route;
+
+  if (exact_per_route) {
+    if (topk_ids.scalar_type() == torch::headeronly::ScalarType::Int) {
+      awq_moe_single_token_exact_layout_prepare_kernel<int32_t>
+          <<<1, kThreads, 0, stream>>>(
+              topk_ids.const_data_ptr<int32_t>(),
+              x.const_data_ptr<__half>(),
+              compact_input.mutable_data_ptr<__half>(),
+               expert_offsets.mutable_data_ptr<int32_t>(), nullptr,
+              inv_permuted_idx.mutable_data_ptr<int32_t>(),
+              sorted_expert_ids.mutable_data_ptr<int32_t>(), top_k,
+              static_cast<int>(x.size(1)),
+              static_cast<int>(source_num_experts));
+    } else {
+      awq_moe_single_token_exact_layout_prepare_kernel<int64_t>
+          <<<1, kThreads, 0, stream>>>(
+              topk_ids.const_data_ptr<int64_t>(),
+              x.const_data_ptr<__half>(),
+              compact_input.mutable_data_ptr<__half>(),
+               expert_offsets.mutable_data_ptr<int32_t>(), nullptr,
+              inv_permuted_idx.mutable_data_ptr<int32_t>(),
+              sorted_expert_ids.mutable_data_ptr<int32_t>(), top_k,
+              static_cast<int>(x.size(1)),
+              static_cast<int>(source_num_experts));
+    }
+  } else if (topk_ids.scalar_type() == torch::headeronly::ScalarType::Int) {
+    awq_moe_single_token_prepare_kernel<int32_t><<<1, kThreads, 0, stream>>>(
+        topk_ids.const_data_ptr<int32_t>(), prepare_topk_weights,
+        x.const_data_ptr<__half>(),
+        src_w13_ptrs_w_rows.const_data_ptr<uint8_t>(),
+        src_w13_ptrs_s_rows.const_data_ptr<uint8_t>(),
+        src_w2_ptrs_w_rows.const_data_ptr<uint8_t>(),
+        src_w2_ptrs_s_rows.const_data_ptr<uint8_t>(),
+        dst_w13_ptrs_w_rows.mutable_data_ptr<uint8_t>(),
+        dst_w13_ptrs_s_rows.mutable_data_ptr<uint8_t>(),
+        dst_w2_ptrs_w_rows.mutable_data_ptr<uint8_t>(),
+        dst_w2_ptrs_s_rows.mutable_data_ptr<uint8_t>(),
+        broadcast_input
+            ? nullptr
+            : compact_input.mutable_data_ptr<__half>(),
+        prepare_sorted_weights, expert_offsets.mutable_data_ptr<int32_t>(), nullptr,
+        inv_permuted_idx.mutable_data_ptr<int32_t>(),
+        indexed_expert_ptrs ? sorted_expert_ids.mutable_data_ptr<int32_t>() : nullptr,
+        top_k, static_cast<int>(x.size(1)), src_row_stride, dst_row_stride,
+        static_cast<int>(row_bytes), copy_expert_ptr_rows, vectorized_prepare);
+  } else {
+    awq_moe_single_token_prepare_kernel<int64_t><<<1, kThreads, 0, stream>>>(
+        topk_ids.const_data_ptr<int64_t>(), prepare_topk_weights,
+        x.const_data_ptr<__half>(),
+        src_w13_ptrs_w_rows.const_data_ptr<uint8_t>(),
+        src_w13_ptrs_s_rows.const_data_ptr<uint8_t>(),
+        src_w2_ptrs_w_rows.const_data_ptr<uint8_t>(),
+        src_w2_ptrs_s_rows.const_data_ptr<uint8_t>(),
+        dst_w13_ptrs_w_rows.mutable_data_ptr<uint8_t>(),
+        dst_w13_ptrs_s_rows.mutable_data_ptr<uint8_t>(),
+        dst_w2_ptrs_w_rows.mutable_data_ptr<uint8_t>(),
+        dst_w2_ptrs_s_rows.mutable_data_ptr<uint8_t>(),
+        broadcast_input
+            ? nullptr
+            : compact_input.mutable_data_ptr<__half>(),
+        prepare_sorted_weights, expert_offsets.mutable_data_ptr<int32_t>(), nullptr,
+        inv_permuted_idx.mutable_data_ptr<int32_t>(),
+        indexed_expert_ptrs ? sorted_expert_ids.mutable_data_ptr<int32_t>() : nullptr,
+        top_k, static_cast<int>(x.size(1)), src_row_stride, dst_row_stride,
+        static_cast<int>(row_bytes), copy_expert_ptr_rows, vectorized_prepare);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+
+  torch::stable::Tensor w13_input = broadcast_input ? x : compact_input;
+  const int64_t w13_logical_total_tokens = broadcast_input ? top_k : -1;
+  const int64_t w13_a_ld_override = -1;
+  torch::stable::Tensor w13_input_indices =
+      (broadcast_input && broadcast_input_indices.numel() > 0)
+          ? broadcast_input_indices
+          : torch::stable::Tensor();
+  torch::stable::Tensor w13_ptrs_w =
+      indexed_expert_ptrs ? src_w13_ptrs_w_rows : dst_w13_ptrs_w_rows;
+  torch::stable::Tensor w13_ptrs_s =
+      indexed_expert_ptrs ? src_w13_ptrs_s_rows : dst_w13_ptrs_s_rows;
+  torch::stable::Tensor w2_ptrs_w =
+      indexed_expert_ptrs ? src_w2_ptrs_w_rows : dst_w2_ptrs_w_rows;
+  torch::stable::Tensor w2_ptrs_s =
+      indexed_expert_ptrs ? src_w2_ptrs_s_rows : dst_w2_ptrs_s_rows;
+  torch::stable::Tensor expert_ptr_indices =
+      indexed_expert_ptrs ? sorted_expert_ids : torch::stable::Tensor();
+  const bool single_token_per_expert_dispatch =
+      vllm::awq_sm70::fp8_moe_single_token_per_expert_dispatch_enabled();
+  if (exact_per_route) {
+    fp8_moe_gemm_sm70_out_impl(
+        gate_up, compact_input, expert_offsets, src_w13_ptrs_w_rows,
+        src_w13_ptrs_s_rows, source_num_experts, w13_k, w13_n, group_size,
+        false, torch::stable::Tensor(), torch::stable::Tensor(), false, -1, -1, torch::stable::Tensor(),
+        torch::stable::Tensor(), false, -1, sorted_expert_ids, top_k);
+    sm70_silu_and_mul_fp16_out(intermediate, gate_up);
+    fp8_moe_gemm_sm70_out_impl(
+        sorted_output, intermediate, expert_offsets, src_w2_ptrs_w_rows,
+        src_w2_ptrs_s_rows, source_num_experts, w2_k, w2_n, group_size, false,
+        torch::stable::Tensor(), torch::stable::Tensor(), false, -1, -1, torch::stable::Tensor(),
+        torch::stable::Tensor(), false, -1, sorted_expert_ids, top_k);
+  } else {
+    if (fused_gated_silu) {
+      fp8_moe_gemm_sm70_out_impl(
+          intermediate, w13_input, expert_offsets, w13_ptrs_w, w13_ptrs_s,
+          top_k, w13_k, w13_n, group_size, true, torch::stable::Tensor(),
+          torch::stable::Tensor(), false, w13_logical_total_tokens, w13_a_ld_override,
+          w13_input_indices, expert_ptr_indices,
+          single_token_per_expert_dispatch, -1);
+    } else {
+      fp8_moe_gemm_sm70_out_impl(
+          gate_up, w13_input, expert_offsets, w13_ptrs_w, w13_ptrs_s, top_k,
+          w13_k, w13_n, group_size, false, torch::stable::Tensor(), torch::stable::Tensor(),
+          false, w13_logical_total_tokens, w13_a_ld_override, w13_input_indices,
+          expert_ptr_indices, single_token_per_expert_dispatch, -1);
+      sm70_silu_and_mul_fp16_out(intermediate, gate_up);
+    }
+    if (fused_weighted_reduce) {
+      fp8_moe_gemm_sm70_out_impl(sorted_output, intermediate, expert_offsets,
+                                 w2_ptrs_w, w2_ptrs_s, top_k, w2_k, w2_n,
+                                 group_size, false, out, sorted_weights, true,
+                                 -1, -1, torch::stable::Tensor(), expert_ptr_indices,
+                                 single_token_per_expert_dispatch, -1);
+      return;
+    }
+    if (w2_direct_reduce) {
+      fp8_moe_w2_direct_reduce_sm70_out(out, intermediate, topk_weights,
+                                        topk_ids, inv_permuted_idx,
+                                        w2_raw_weight, w2_raw_scale_inv, top_k,
+                                        w2_k, w2_n, group_size, stream);
+      return;
+    }
+
+    fp8_moe_gemm_sm70_out_impl(
+        sorted_output, intermediate, expert_offsets, w2_ptrs_w, w2_ptrs_s,
+        top_k, w2_k, w2_n, group_size, false, torch::stable::Tensor(), torch::stable::Tensor(),
+        false, -1, -1, torch::stable::Tensor(), expert_ptr_indices,
+        single_token_per_expert_dispatch, -1);
+  }
+
+  const int hidden_logical_size_i = static_cast<int>(hidden_logical_size);
+  const int sorted_output_row_stride =
+      static_cast<int>(sorted_output.stride(0));
+  if (top_k == 8 && (hidden_logical_size_i % 2) == 0 &&
+      (sorted_output_row_stride % 2) == 0) {
+    const int blocks = std::max<int>(
+        1, ((hidden_logical_size_i >> 1) + kThreads - 1) / kThreads);
+    awq_moe_single_token_weighted_reduce_half2_kernel<8>
+        <<<blocks, kThreads, 0, stream>>>(
+            sorted_output.const_data_ptr<__half>(),
+            topk_weights.const_data_ptr<float>(),
+            inv_permuted_idx.mutable_data_ptr<int32_t>(),
+            out.mutable_data_ptr<__half>(),
+            hidden_logical_size_i, sorted_output_row_stride);
+  } else {
+    const int blocks =
+        std::max<int>(1, (hidden_logical_size_i + kThreads - 1) / kThreads);
+    awq_moe_single_token_weighted_reduce_kernel<<<blocks, kThreads, 0,
+                                                  stream>>>(
+        sorted_output.const_data_ptr<__half>(),
+        topk_weights.const_data_ptr<float>(), inv_permuted_idx.mutable_data_ptr<int32_t>(),
+        out.mutable_data_ptr<__half>(), top_k,
+        hidden_logical_size_i, sorted_output_row_stride);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+  #if defined(VLLM_ENABLE_SM70_TURBOMIND_EXPERIMENTAL_MOE)
+
+void fp8_moe_single_token_router_sm70_out(
+    torch::stable::Tensor out, torch::stable::Tensor x, torch::stable::Tensor router_logits,
+    torch::stable::Tensor topk_weights, torch::stable::Tensor topk_ids,
+    torch::stable::Tensor src_w13_ptrs_w_rows, torch::stable::Tensor src_w13_ptrs_s_rows,
+    torch::stable::Tensor src_w2_ptrs_w_rows, torch::stable::Tensor src_w2_ptrs_s_rows,
+    torch::stable::Tensor compact_input, torch::stable::Tensor gate_up,
+    torch::stable::Tensor intermediate, torch::stable::Tensor sorted_output,
+    torch::stable::Tensor sorted_weights, torch::stable::Tensor dst_w13_ptrs_w_rows,
+    torch::stable::Tensor dst_w13_ptrs_s_rows, torch::stable::Tensor dst_w2_ptrs_w_rows,
+    torch::stable::Tensor dst_w2_ptrs_s_rows, torch::stable::Tensor expert_offsets,
+    torch::stable::Tensor inv_permuted_idx, int64_t w13_k, int64_t w13_n, int64_t w2_k,
+    int64_t w2_n, int64_t group_size, int64_t hidden_logical_size,
+    bool renormalize, bool fused_gated_silu, bool fused_weighted_reduce) {
+  STD_TORCH_CHECK(
+      out.is_cuda() && out.scalar_type() == torch::headeronly::ScalarType::Half,
+      "fp8_moe_single_token_router_sm70_out: out must be CUDA float16.");
+  STD_TORCH_CHECK(x.is_cuda() && x.scalar_type() == torch::headeronly::ScalarType::Half,
+              "fp8_moe_single_token_router_sm70_out: x must be CUDA float16.");
+  STD_TORCH_CHECK(
+      router_logits.is_cuda() && router_logits.scalar_type() == torch::headeronly::ScalarType::Half,
+      "fp8_moe_single_token_router_sm70_out: router_logits must be CUDA "
+      "float16.");
+  STD_TORCH_CHECK(
+      topk_weights.is_cuda() && topk_weights.scalar_type() == torch::headeronly::ScalarType::Float,
+      "fp8_moe_single_token_router_sm70_out: topk_weights must be CUDA "
+      "float32.");
+  STD_TORCH_CHECK(
+      topk_ids.is_cuda() && topk_ids.scalar_type() == torch::headeronly::ScalarType::Int,
+      "fp8_moe_single_token_router_sm70_out: topk_ids must be CUDA int32.");
+  STD_TORCH_CHECK(
+      compact_input.is_cuda() &&
+          compact_input.scalar_type() == torch::headeronly::ScalarType::Half && gate_up.is_cuda() &&
+          gate_up.scalar_type() == torch::headeronly::ScalarType::Half && intermediate.is_cuda() &&
+          intermediate.scalar_type() == torch::headeronly::ScalarType::Half &&
+          sorted_output.is_cuda() &&
+          sorted_output.scalar_type() == torch::headeronly::ScalarType::Half,
+      "fp8_moe_single_token_router_sm70_out: scratch buffers must be CUDA "
+      "float16.");
+  STD_TORCH_CHECK(sorted_weights.is_cuda() &&
+                  sorted_weights.scalar_type() == torch::headeronly::ScalarType::Float,
+              "fp8_moe_single_token_router_sm70_out: sorted_weights must be "
+              "CUDA float32.");
+  STD_TORCH_CHECK(expert_offsets.is_cuda() &&
+                  expert_offsets.scalar_type() == torch::headeronly::ScalarType::Int &&
+                  inv_permuted_idx.is_cuda() &&
+                  inv_permuted_idx.scalar_type() == torch::headeronly::ScalarType::Int,
+              "fp8_moe_single_token_router_sm70_out: index buffers must be "
+              "CUDA int32.");
+  STD_TORCH_CHECK(
+      src_w13_ptrs_w_rows.is_cuda() && src_w13_ptrs_s_rows.is_cuda() &&
+          src_w2_ptrs_w_rows.is_cuda() && src_w2_ptrs_s_rows.is_cuda() &&
+          dst_w13_ptrs_w_rows.is_cuda() && dst_w13_ptrs_s_rows.is_cuda() &&
+          dst_w2_ptrs_w_rows.is_cuda() && dst_w2_ptrs_s_rows.is_cuda(),
+      "fp8_moe_single_token_router_sm70_out: ptr rows must be CUDA.");
+  STD_TORCH_CHECK(
+      x.dim() == 2 && x.size(0) == 1,
+      "fp8_moe_single_token_router_sm70_out: x must have shape [1, hidden].");
+  STD_TORCH_CHECK(router_logits.dim() == 2 && router_logits.size(0) == 1 &&
+                  router_logits.size(1) == 256,
+              "fp8_moe_single_token_router_sm70_out: only [1, 256] router "
+              "logits are supported.");
+  STD_TORCH_CHECK(
+      out.dim() == 2 && out.size(0) == 1,
+      "fp8_moe_single_token_router_sm70_out: out must have shape [1, hidden].");
+  STD_TORCH_CHECK(out.size(1) == hidden_logical_size,
+              "fp8_moe_single_token_router_sm70_out: out cols must match "
+              "hidden_logical_size.");
+
+  topk_ids = torch::stable::contiguous(torch::stable::view(topk_ids, {-1}));
+  topk_weights = torch::stable::contiguous(torch::stable::view(topk_weights, {-1}));
+  inv_permuted_idx = torch::stable::contiguous(torch::stable::view(inv_permuted_idx, {-1}));
+  sorted_weights = torch::stable::contiguous(torch::stable::view(sorted_weights, {-1}));
+
+  const int top_k = static_cast<int>(topk_ids.numel());
+  STD_TORCH_CHECK(
+      top_k == 8,
+      "fp8_moe_single_token_router_sm70_out: only top_k=8 is supported.");
+  STD_TORCH_CHECK(
+      static_cast<int>(topk_weights.numel()) == top_k,
+      "fp8_moe_single_token_router_sm70_out: topk_weights size mismatch.");
+  STD_TORCH_CHECK(
+      sorted_weights.numel() == top_k,
+      "fp8_moe_single_token_router_sm70_out: sorted_weights size mismatch.");
+  STD_TORCH_CHECK(
+      compact_input.dim() == 2 && compact_input.size(0) == top_k &&
+          compact_input.size(1) == x.size(1),
+      "fp8_moe_single_token_router_sm70_out: compact_input shape mismatch.");
+  STD_TORCH_CHECK(gate_up.dim() == 2 && gate_up.size(0) == top_k &&
+                  gate_up.size(1) == w13_n,
+              "fp8_moe_single_token_router_sm70_out: gate_up shape mismatch.");
+  STD_TORCH_CHECK(
+      intermediate.dim() == 2 && intermediate.size(0) == top_k &&
+          intermediate.size(1) == w13_n / 2,
+      "fp8_moe_single_token_router_sm70_out: intermediate shape mismatch.");
+  STD_TORCH_CHECK(
+      sorted_output.dim() == 2 && sorted_output.size(0) == top_k &&
+          sorted_output.size(1) == w2_n,
+      "fp8_moe_single_token_router_sm70_out: sorted_output shape mismatch.");
+  STD_TORCH_CHECK(
+      expert_offsets.numel() == top_k + 1,
+      "fp8_moe_single_token_router_sm70_out: expert_offsets size mismatch.");
+  STD_TORCH_CHECK(
+      inv_permuted_idx.numel() == top_k,
+      "fp8_moe_single_token_router_sm70_out: inv_permuted_idx size mismatch.");
+
+  const int64_t row_bytes = src_w13_ptrs_w_rows.size(1);
+  STD_TORCH_CHECK(
+      src_w13_ptrs_w_rows.dim() == 2 && src_w13_ptrs_s_rows.dim() == 2 &&
+          src_w2_ptrs_w_rows.dim() == 2 && src_w2_ptrs_s_rows.dim() == 2 &&
+          dst_w13_ptrs_w_rows.dim() == 2 && dst_w13_ptrs_s_rows.dim() == 2 &&
+          dst_w2_ptrs_w_rows.dim() == 2 && dst_w2_ptrs_s_rows.dim() == 2,
+      "fp8_moe_single_token_router_sm70_out: ptr row tensors must be 2D.");
+  STD_TORCH_CHECK(dst_w13_ptrs_w_rows.size(0) == top_k &&
+                  dst_w13_ptrs_s_rows.size(0) == top_k &&
+                  dst_w2_ptrs_w_rows.size(0) == top_k &&
+                  dst_w2_ptrs_s_rows.size(0) == top_k &&
+                  dst_w13_ptrs_w_rows.size(1) == row_bytes &&
+                  dst_w13_ptrs_s_rows.size(1) == row_bytes &&
+                  dst_w2_ptrs_w_rows.size(1) == row_bytes &&
+                  dst_w2_ptrs_s_rows.size(1) == row_bytes,
+              "fp8_moe_single_token_router_sm70_out: destination ptr row "
+              "shapes mismatch.");
+
+  const torch::stable::accelerator::DeviceGuard device_guard(x.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream();
+  const int src_row_stride = static_cast<int>(src_w13_ptrs_w_rows.stride(0));
+  const int dst_row_stride = static_cast<int>(dst_w13_ptrs_w_rows.stride(0));
+  const bool vectorized_prepare = sm70_fp8_moe_prepare_vec_enabled();
+  constexpr int kThreads = 256;
+
+  fp8_moe_single_token_router_prepare_256_top8_kernel<<<1, kThreads, 0,
+                                                        stream>>>(
+      router_logits.const_data_ptr<__half>(),
+      topk_weights.const_data_ptr<float>(), topk_ids.const_data_ptr<int32_t>(),
+      x.const_data_ptr<__half>(),
+      src_w13_ptrs_w_rows.const_data_ptr<uint8_t>(),
+      src_w13_ptrs_s_rows.const_data_ptr<uint8_t>(),
+      src_w2_ptrs_w_rows.const_data_ptr<uint8_t>(),
+      src_w2_ptrs_s_rows.const_data_ptr<uint8_t>(),
+      dst_w13_ptrs_w_rows.mutable_data_ptr<uint8_t>(),
+      dst_w13_ptrs_s_rows.mutable_data_ptr<uint8_t>(),
+      dst_w2_ptrs_w_rows.mutable_data_ptr<uint8_t>(),
+      dst_w2_ptrs_s_rows.mutable_data_ptr<uint8_t>(),
+      compact_input.mutable_data_ptr<__half>(),
+      sorted_weights.const_data_ptr<float>(), expert_offsets.const_data_ptr<int32_t>(),
+      inv_permuted_idx.mutable_data_ptr<int32_t>(), static_cast<int>(x.size(1)),
+      src_row_stride, dst_row_stride, static_cast<int>(row_bytes), renormalize,
+      vectorized_prepare);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+
+  if (fused_gated_silu) {
+    fp8_moe_gemm_sm70_out_impl(intermediate, compact_input, expert_offsets,
+                               dst_w13_ptrs_w_rows, dst_w13_ptrs_s_rows, top_k,
+                               w13_k, w13_n, group_size, true, torch::stable::Tensor(),
+                               torch::stable::Tensor(), false, -1, -1);
+  } else {
+    fp8_moe_gemm_sm70_out_impl(gate_up, compact_input, expert_offsets,
+                               dst_w13_ptrs_w_rows, dst_w13_ptrs_s_rows, top_k,
+                               w13_k, w13_n, group_size, false, torch::stable::Tensor(),
+                               torch::stable::Tensor(), false, -1, -1);
+    sm70_silu_and_mul_fp16_out(intermediate, gate_up);
+  }
+  if (fused_weighted_reduce) {
+    fp8_moe_gemm_sm70_out_impl(sorted_output, intermediate, expert_offsets,
+                               dst_w2_ptrs_w_rows, dst_w2_ptrs_s_rows, top_k,
+                               w2_k, w2_n, group_size, false, out,
+                               sorted_weights, true, -1, -1);
+    return;
+  }
+
+  fp8_moe_gemm_sm70_out(sorted_output, intermediate, expert_offsets,
+                        dst_w2_ptrs_w_rows, dst_w2_ptrs_s_rows, top_k, w2_k,
+                        w2_n, group_size, false);
+
+  const int hidden_logical_size_i = static_cast<int>(hidden_logical_size);
+  const int sorted_output_row_stride =
+      static_cast<int>(sorted_output.stride(0));
+  if ((hidden_logical_size_i % 2) == 0 && (sorted_output_row_stride % 2) == 0) {
+    const int blocks = std::max<int>(
+        1, ((hidden_logical_size_i >> 1) + kThreads - 1) / kThreads);
+    awq_moe_single_token_weighted_reduce_half2_kernel<8>
+        <<<blocks, kThreads, 0, stream>>>(
+            sorted_output.const_data_ptr<__half>(),
+            topk_weights.const_data_ptr<float>(),
+            inv_permuted_idx.mutable_data_ptr<int32_t>(),
+            out.mutable_data_ptr<__half>(),
+            hidden_logical_size_i, sorted_output_row_stride);
+  } else {
+    const int blocks =
+        std::max<int>(1, (hidden_logical_size_i + kThreads - 1) / kThreads);
+    awq_moe_single_token_weighted_reduce_kernel<<<blocks, kThreads, 0,
+                                                  stream>>>(
+        sorted_output.const_data_ptr<__half>(),
+        topk_weights.const_data_ptr<float>(), inv_permuted_idx.mutable_data_ptr<int32_t>(),
+        out.mutable_data_ptr<__half>(), top_k,
+        hidden_logical_size_i, sorted_output_row_stride);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+  #endif  // defined(VLLM_ENABLE_SM70_TURBOMIND_EXPERIMENTAL_MOE)
+
+#endif  // defined(ENABLE_SM70_TURBOMIND)
diff --git a/csrc/sm70_turbomind/ops/diffusion_epilogue.h b/csrc/sm70_turbomind/ops/diffusion_epilogue.h
new file mode 100644
index 0000000..423576b
--- /dev/null
+++ b/csrc/sm70_turbomind/ops/diffusion_epilogue.h
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+#pragma once
+
+#include <cuda_fp16.h>
+#include <torch/extension.h>
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <optional>
+#include <type_traits>
+#include <libtorch_stable/torch_utils.h>
+#include <torch/csrc/stable/macros.h>
+#include <torch/csrc/stable/tensor.h>
+#include <torch/csrc/stable/ops.h>
+#include <torch/csrc/stable/accelerator.h>
+#include <torch/headeronly/core/ScalarType.h>
+#include <torch/headeronly/util/HeaderOnlyArrayRef.h>
+
+namespace sm70_diffusion {
+
+namespace {
+constexpr size_t kNoOverlapSentinel = SIZE_MAX;
+} // namespace
+
+static void tm_assert_no_overlap(const torch::Tensor& a,
+                                 const torch::Tensor& b) {
+  if (!a.is_contiguous() || !b.is_contiguous()) return;
+  auto pa = a.const_data_ptr<std::byte>();
+  auto pb = b.const_data_ptr<std::byte>();
+  if (pa == nullptr || pb == nullptr) return;
+  auto la = static_cast<size_t>(a.numel()) * a.element_size();
+  auto lb = static_cast<size_t>(b.numel()) * b.element_size();
+  auto lo = std::min(pa, pb);
+  auto hi = std::max(pa + la, pb + lb);
+  if (hi - lo < std::max(la, lb)) {
+    throw std::runtime_error(
+        "Input and output overlap");
+  }
+}
+
+template <typename Output>
+__global__ void scaled_add_rows(Output* output, const float* delta,
+                                const float* scales, int64_t count,
+                                int64_t width, int64_t output_width,
+                                int64_t offset, float alpha) {
+  for (int64_t index = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+       index < count; index += int64_t(gridDim.x) * blockDim.x) {
+    const int64_t row = index / width;
+    const int64_t col = index - row * width;
+    const int64_t destination = row * output_width + offset + col;
+    // Retain the explicit FP32 scale-restoration boundary before addition.
+    const float restored =
+        scales ? __fmul_rn(delta[index], scales[row]) : delta[index];
+    float base;
+    if constexpr (std::is_same_v<Output, half>) {
+      base = __half2float(output[destination]);
+    } else {
+      base = output[destination];
+    }
+    const float result = __fmaf_rn(alpha, restored, base);
+    if constexpr (std::is_same_v<Output, half>) {
+      output[destination] = __float2half_rn(result);
+    } else {
+      output[destination] = result;
+    }
+  }
+}
+
+inline torch::Tensor scaled_add(torch::Tensor output, torch::Tensor delta,
+                                std::optional<torch::Tensor> scales,
+                                double alpha, int64_t offset) {
+  STD_TORCH_CHECK(output.is_cuda() && output.dim() == 2 && output.is_contiguous(),
+              "SM70 scaled addition requires contiguous CUDA [M,N] output");
+  STD_TORCH_CHECK(output.scalar_type() == torch::headeronly::ScalarType::Half ||
+                  output.scalar_type() == torch::headeronly::ScalarType::Float,
+              "SM70 scaled addition output must be FP16 or FP32");
+  STD_TORCH_CHECK(delta.device() == output.device() && delta.dim() == 2 &&
+                  delta.is_contiguous() &&
+                  delta.scalar_type() == torch::headeronly::ScalarType::Float &&
+                  delta.size(0) == output.size(0),
+              "SM70 scaled addition requires matching FP32 [M,K] delta");
+  STD_TORCH_CHECK(offset >= 0 && offset <= output.size(1) &&
+                  delta.size(1) <= output.size(1) - offset,
+              "SM70 scaled addition slice is outside output");
+  STD_TORCH_CHECK(std::isfinite(alpha) &&
+                  std::abs(alpha) <= std::numeric_limits<float>::max(),
+              "SM70 scaled addition alpha must be finite FP32");
+  STD_TORCH_CHECK(!output.requires_grad() && !delta.requires_grad(),
+              "SM70 scaled addition is inference-only");
+  tm_assert_no_overlap(output, delta);
+  const torch::stable::accelerator::DeviceGuard guard(output.device().index());
+  cudaDeviceProp properties_local;
+int properties_dev = 0;
+cudaGetDevice(&properties_dev);
+cudaGetDeviceProperties(&properties_local, properties_dev);
+const auto* properties = &properties_local;
+  STD_TORCH_CHECK(properties->major == 7 && properties->minor == 0,
+              "SM70 scaled addition requires SM70");
+  const float* scale_data = nullptr;
+  if (scales.has_value()) {
+    STD_TORCH_CHECK(
+        scales->device() == output.device() && scales->is_contiguous() &&
+            scales->scalar_type() == torch::headeronly::ScalarType::Float &&
+            scales->numel() == output.size(0) && !scales->requires_grad(),
+        "SM70 scaled addition needs one FP32 scale per row");
+    tm_assert_no_overlap(output, *scales);
+    scale_data = scales->data_ptr<float>();
+  }
+  if (!delta.numel()) return output;
+  const int blocks = std::min<int64_t>((delta.numel() + 255) / 256, 65535);
+  const auto stream = get_current_cuda_stream();
+  if (output.scalar_type() == torch::headeronly::ScalarType::Half) {
+    scaled_add_rows<<<blocks, 256, 0, stream>>>(
+        reinterpret_cast<half*>(output.data_ptr<at::Half>()),
+        delta.data_ptr<float>(), scale_data, delta.numel(), delta.size(1),
+        output.size(1), offset, float(alpha));
+  } else {
+    scaled_add_rows<<<blocks, 256, 0, stream>>>(
+        output.data_ptr<float>(), delta.data_ptr<float>(), scale_data,
+        delta.numel(), delta.size(1), output.size(1), offset, float(alpha));
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  return output;
+}
+}  // namespace sm70_diffusion
diff --git a/csrc/sm70_turbomind/ops/exact_row_reduce.cu b/csrc/sm70_turbomind/ops/exact_row_reduce.cu
new file mode 100644
index 0000000..5d5e81f
--- /dev/null
+++ b/csrc/sm70_turbomind/ops/exact_row_reduce.cu
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+#include <torch/extension.h>
+#include <cuda_runtime.h>
+#include <cstring>
+#include <cstdio>
+#include <cstdlib>
+#include <array>
+#include <libtorch_stable/torch_utils.h>
+#include <torch/csrc/stable/macros.h>
+#include <torch/csrc/stable/tensor.h>
+#include <torch/csrc/stable/ops.h>
+#include <torch/csrc/stable/accelerator.h>
+#include <torch/headeronly/core/ScalarType.h>
+#include <torch/headeronly/util/HeaderOnlyArrayRef.h>
+
+#ifndef C10_CUDA_CHECK
+#define C10_CUDA_CHECK(call)                                                       \
+  do {                                                                              \
+    cudaError_t _cke_err = (call);                                                  \
+    if (_cke_err != cudaSuccess) {                                                   \
+      fprintf(stderr, "[sm70] CUDA error: %s\n", cudaGetErrorString(_cke_err));   \
+      std::abort();                                                                 \
+    }                                                                                \
+  } while (0)
+#endif
+#ifndef C10_CUDA_KERNEL_LAUNCH_CHECK
+#define C10_CUDA_KERNEL_LAUNCH_CHECK()                                              \
+  do {                                                                               \
+    cudaError_t _cklc_err = cudaGetLastError();                                      \
+    if (_cklc_err != cudaSuccess) {                                                 \
+      fprintf(stderr, "[sm70] kernel launch error: %s\n",                           \
+              cudaGetErrorString(_cklc_err));                                        \
+      std::abort();                                                                  \
+    }                                                                                \
+  } while (0)
+#endif
+
+struct Peers {
+  float* data[4];
+  unsigned* flags[4];
+};
+constexpr int GRID = 80;
+__device__ __forceinline__ void publish(unsigned* p, unsigned value) {
+  asm volatile("st.release.sys.global.u32 [%0], %1;" ::"l"(p), "r"(value)
+               : "memory");
+}
+__device__ __forceinline__ unsigned acquire(unsigned* p) {
+  unsigned value;
+  asm volatile("ld.acquire.sys.global.u32 %0, [%1];"
+               : "=r"(value)
+               : "l"(p)
+               : "memory");
+  return value;
+}
+__device__ __forceinline__ void barrier(Peers peers, int rank, unsigned epoch,
+                                        int phase) {
+  __syncthreads();
+  if (threadIdx.x < 4) {
+    int peer = threadIdx.x;
+    int location = phase * GRID * 4 + blockIdx.x * 4;
+    publish(peers.flags[peer] + location + rank, epoch);
+    while (acquire(peers.flags[rank] + location + peer) != epoch) {
+    }
+  }
+  __syncthreads();
+}
+__device__ __forceinline__ float tree(unsigned code, float x0, float x1,
+                                      float x2, float x3) {
+  switch (code) {
+    case 0:
+      return __fadd_rn(x0, __fadd_rn(x1, __fadd_rn(x2, x3)));
+    case 1:
+      return __fadd_rn(x0, __fadd_rn(__fadd_rn(x1, x2), x3));
+    case 2:
+      return __fadd_rn(x0, __fadd_rn(__fadd_rn(x1, x3), x2));
+    case 3:
+      return __fadd_rn(__fadd_rn(x0, x1), __fadd_rn(x2, x3));
+    case 4:
+      return __fadd_rn(__fadd_rn(x0, x2), __fadd_rn(x1, x3));
+    case 5:
+      return __fadd_rn(__fadd_rn(x0, x3), __fadd_rn(x1, x2));
+    case 6:
+      return __fadd_rn(__fadd_rn(x0, __fadd_rn(x1, x2)), x3);
+    case 7:
+      return __fadd_rn(__fadd_rn(__fadd_rn(x0, x1), x2), x3);
+    case 8:
+      return __fadd_rn(__fadd_rn(__fadd_rn(x0, x2), x1), x3);
+    case 9:
+      return __fadd_rn(__fadd_rn(x0, __fadd_rn(x1, x3)), x2);
+    case 10:
+      return __fadd_rn(__fadd_rn(__fadd_rn(x0, x1), x3), x2);
+    case 11:
+      return __fadd_rn(__fadd_rn(__fadd_rn(x0, x3), x1), x2);
+    case 12:
+      return __fadd_rn(__fadd_rn(x0, __fadd_rn(x2, x3)), x1);
+    case 13:
+      return __fadd_rn(__fadd_rn(__fadd_rn(x0, x2), x3), x1);
+    case 14:
+      return __fadd_rn(__fadd_rn(__fadd_rn(x0, x3), x2), x1);
+    default:
+      return __int_as_float(0x7fffffff);
+  }
+}
+__global__ void reduce_rows(Peers peers, const uint8_t* codes, float* output,
+                            int64_t count, int64_t offset, int rank,
+                            unsigned epoch) {
+  barrier(peers, rank, epoch, 0);
+  for (int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x; i < count;
+       i += int64_t(gridDim.x) * blockDim.x) {
+    int64_t at = offset + i;
+    float x0 = __ldcg(peers.data[0] + at);
+    float x1 = __ldcg(peers.data[1] + at);
+    float x2 = __ldcg(peers.data[2] + at);
+    float x3 = __ldcg(peers.data[3] + at);
+    output[i] = tree(codes[i], x0, x1, x2, x3);
+  }
+  barrier(peers, rank, epoch, 1);
+}
+std::tuple<int64_t, pybind11::bytes> allocate(int64_t bytes) {
+  STD_TORCH_CHECK(bytes > 0);
+  void* ptr = nullptr;
+  C10_CUDA_CHECK(cudaMalloc(&ptr, bytes));
+  cudaIpcMemHandle_t handle;
+  try {
+    C10_CUDA_CHECK(cudaIpcGetMemHandle(&handle, ptr));
+    C10_CUDA_CHECK(cudaMemset(ptr, 0, bytes));
+  } catch (...) {
+    cudaFree(ptr);
+    throw;
+  }
+  return {reinterpret_cast<int64_t>(ptr),
+          pybind11::bytes(reinterpret_cast<char*>(&handle), sizeof(handle))};
+}
+int64_t open_handle(pybind11::bytes bytes) {
+  std::string value = bytes;
+  STD_TORCH_CHECK(value.size() == sizeof(cudaIpcMemHandle_t));
+  cudaIpcMemHandle_t handle;
+  std::memcpy(&handle, value.data(), sizeof(handle));
+  void* ptr = nullptr;
+  C10_CUDA_CHECK(
+      cudaIpcOpenMemHandle(&ptr, handle, cudaIpcMemLazyEnablePeerAccess));
+  return reinterpret_cast<int64_t>(ptr);
+}
+void release(int64_t ptr, bool owner) {
+  if (owner)
+    C10_CUDA_CHECK(cudaFree(reinterpret_cast<void*>(ptr)));
+  else
+    C10_CUDA_CHECK(cudaIpcCloseMemHandle(reinterpret_cast<void*>(ptr)));
+}
+void run(torch::Tensor input, torch::Tensor codes, torch::Tensor output,
+         std::vector<int64_t> pointers, std::vector<int64_t> flags, int rank,
+         unsigned epoch) {
+  STD_TORCH_CHECK(input.is_cuda() && input.scalar_type() == torch::headeronly::ScalarType::Float &&
+              input.is_contiguous());
+  STD_TORCH_CHECK(codes.is_cuda() && codes.scalar_type() == torch::headeronly::ScalarType::Byte &&
+              codes.is_contiguous());
+  STD_TORCH_CHECK(output.is_cuda() && output.scalar_type() == torch::headeronly::ScalarType::Float &&
+              output.is_contiguous());
+  STD_TORCH_CHECK(input.device() == codes.device() &&
+              input.device() == output.device());
+  STD_TORCH_CHECK(rank >= 0 && rank < 4 && pointers.size() == 4 &&
+              flags.size() == 4 && epoch > 0);
+  STD_TORCH_CHECK(input.numel() == output.numel() * 4 &&
+              codes.numel() == output.numel());
+  const torch::stable::accelerator::DeviceGuard guard(input.device().index());
+  auto stream = get_current_cuda_stream();
+  cudaDeviceProp _cb_props_properties;
+  int _cb_dev_properties = input.device().index();
+cudaGetDeviceProperties(&_cb_props_properties, _cb_dev_properties);
+const auto* properties = &_cb_props_properties;
+  STD_TORCH_CHECK(
+      properties->major == 7 && properties->minor == 0 &&
+          properties->multiProcessorCount >= GRID,
+      "Exact peer reduction requires an SM70 device with at least 80 SMs");
+  Peers peers;
+  for (int i = 0; i < 4; ++i) {
+    STD_TORCH_CHECK(pointers[i] && flags[i]);
+    peers.data[i] = reinterpret_cast<float*>(pointers[i]);
+    peers.flags[i] = reinterpret_cast<unsigned*>(flags[i]);
+  }
+  C10_CUDA_CHECK(cudaMemcpyAsync(peers.data[rank], input.data_ptr(),
+                                 input.nbytes(), cudaMemcpyDeviceToDevice,
+                                 stream));
+  reduce_rows<<<GRID, 256, 0, stream>>>(
+      peers, codes.data_ptr<uint8_t>(), output.data_ptr<float>(),
+      output.numel(), output.numel() * rank, rank, epoch);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("allocate", &allocate);
+  m.def("open_handle", &open_handle);
+  m.def("release", &release);
+  m.def("run", &run);
+}
