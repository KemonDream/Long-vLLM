+        topk_ids.const_data_ptr<int>(), sorted_row_idx.mutable_data_ptr<int>(),
+        inv_permuted_idx.mutable_data_ptr<int>(), compact_offsets.mutable_data_ptr<int>(),
+        active_expert_ids.mutable_data_ptr<int>());
