+void mxfp4_gemm_sm70_out(torch::stable::Tensor out, torch::stable::Tensor in_feats,
+                         torch::stable::Tensor tm_weight, torch::stable::Tensor tm_scales,
+                         int64_t group_size, int64_t k_ld, int64_t q_ld,
+                         bool gated_silu) {
+  STD_TORCH_CHECK(in_feats.is_cuda(), "mxfp4_gemm_sm70: input must be CUDA.");
+  STD_TORCH_CHECK(tm_weight.is_cuda(), "mxfp4_gemm_sm70: weight must be CUDA.");
+  STD_TORCH_CHECK(tm_scales.is_cuda(), "mxfp4_gemm_sm70: scales must be CUDA.");
