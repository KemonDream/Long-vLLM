+void sm70_f16_gate_mul_out(torch::stable::Tensor out, torch::stable::Tensor in_feats,
+                           torch::stable::Tensor gate_weight) {
+  validate_f16_gate_mul_input(out, in_feats, gate_weight);
+
+  const torch::stable::accelerator::DeviceGuard device_guard(in_feats.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream();
+
+  const int64_t m = in_feats.size(0);
+  const int64_t k = in_feats.size(1);
+  const int64_t n = out.size(1);
+  if (m == 0 || n == 0) {
+    return;
+  }
+
+  constexpr int kThreads = 256;
+  sm70_f16_gate_mul_kernel<kThreads>
+      <<<static_cast<unsigned int>(m), kThreads, 0, stream>>>(
+          out.mutable_data_ptr<half>(),
+          reinterpret_cast<const half*>(in_feats.const_data_ptr<half>()),
+          reinterpret_cast<const half*>(gate_weight.const_data_ptr<half>()),
+          static_cast<int>(m), static_cast<int>(n), static_cast<int>(k),
+          out.stride(0), in_feats.stride(0));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+torch::stable::Tensor awq_gemm_sm70(torch::stable::Tensor in_feats, torch::stable::Tensor tm_weight,
+                            torch::stable::Tensor tm_scales, int64_t group_size,
+                            int64_t k_ld, int64_t q_ld) {
+  const int64_t n = tm_weight.size(1) * 8;
+  auto out = torch::stable::empty({in_feats.size(0), n}, in_feats.scalar_type(),
+                                   std::nullopt, in_feats.device());
+  awq_gemm_sm70_out(out, in_feats, tm_weight, tm_scales, group_size, k_ld, q_ld,
+                    false);
+  return out;
+}
+
+torch::stable::Tensor sm70_f16_gemm(torch::stable::Tensor in_feats, torch::stable::Tensor weight) {
+  validate_f16_weight(weight, "sm70_f16_gemm");
+  STD_TORCH_CHECK(in_feats.is_cuda(), "sm70_f16_gemm: input must be CUDA.");
+  STD_TORCH_CHECK(in_feats.scalar_type() == torch::headeronly::ScalarType::Half,
+              "sm70_f16_gemm: input must be float16.");
+  STD_TORCH_CHECK(in_feats.dim() == 2, "sm70_f16_gemm: input must be 2D.");
+  STD_TORCH_CHECK(in_feats.size(1) == weight.size(1),
+              "sm70_f16_gemm: input/weight K mismatch.");
+  if (in_feats.size(0) > sm70_f16_dense_max_m()) {
+    return torch::stable::matmul(in_feats, torch::stable::transpose(weight, 0, 1));
+  }
+  const torch::stable::accelerator::DeviceGuard device_guard(weight.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream();
+  const auto entry = get_sm70_f16_cached_weight(weight, stream);
+  const int64_t n = weight.size(0);
+  auto out = torch::stable::empty({in_feats.size(0), n}, in_feats.scalar_type(),
+                                   std::nullopt, in_feats.device());
+  sm70_f16_gemm_out(out, in_feats, entry.tm_weight, entry.k_ld, false);
+  return out;
+}
