+struct DenseTuneKey {
+  TuneKeyKind kind;
+  int device;
+  int m;
+  int n;
+  int k;
+  int group_size;
+
+  bool operator==(const DenseTuneKey& other) const {
+    return kind == other.kind && device == other.device && m == other.m &&
+           n == other.n && k == other.k && group_size == other.group_size;
+  }
