+void mxfp4_moe_qpn_m1_sm70_out(torch::stable::Tensor out, torch::stable::Tensor input,
+                               torch::stable::Tensor weights, torch::stable::Tensor scales,
+                               torch::stable::Tensor expert_ids, bool broadcast_input) {
+  STD_TORCH_CHECK(out.is_cuda() && input.is_cuda() && weights.is_cuda() &&
+                  scales.is_cuda() && expert_ids.is_cuda(),
+              "mxfp4_moe_qpn_m1_sm70_out: tensors must be CUDA tensors");
+  STD_TORCH_CHECK(out.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  input.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  weights.scalar_type() == torch::headeronly::ScalarType::Int &&
+                  scales.scalar_type() == torch::headeronly::ScalarType::Byte &&
+                  expert_ids.scalar_type() == torch::headeronly::ScalarType::Int,
+              "mxfp4_moe_qpn_m1_sm70_out: dtype mismatch");
+  STD_TORCH_CHECK(out.is_contiguous() && input.is_contiguous() &&
+                  weights.is_contiguous() && scales.is_contiguous() &&
+                  expert_ids.is_contiguous(),
+              "mxfp4_moe_qpn_m1_sm70_out: tensors must be contiguous");
+  STD_TORCH_CHECK(out.dim() == 2 && input.dim() == 2 && weights.dim() == 3 &&
+                  scales.dim() == 3 && expert_ids.dim() == 1,
+              "mxfp4_moe_qpn_m1_sm70_out: rank mismatch");
+  STD_TORCH_CHECK(out.size(0) == 6 && expert_ids.numel() == 6 &&
+                  weights.size(0) == 256 && scales.size(0) == 256,
+              "mxfp4_moe_qpn_m1_sm70_out: expected six routes and 256 experts");
+  STD_TORCH_CHECK(input.get_device_index() == out.get_device_index() &&
+                  input.get_device_index() == weights.get_device_index() &&
+                  input.get_device_index() == scales.get_device_index() &&
+                  input.get_device_index() == expert_ids.get_device_index(),
+              "mxfp4_moe_qpn_m1_sm70_out: device mismatch");
+
+  const torch::stable::accelerator::DeviceGuard device_guard(input.get_device_index());
+  if (broadcast_input) {
+    STD_TORCH_CHECK(stable_array_ref_eq(input.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({1, 4096})) &&
+                    stable_array_ref_eq(out.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({6, 1024})) &&
+                    stable_array_ref_eq(weights.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({256, 4096, 128})) &&
+                    stable_array_ref_eq(scales.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({256, 128, 1024})),
+                "mxfp4_moe_qpn_m1_sm70_out: W13 tensor contract mismatch");
+    launch_mxfp4_qpn_m1<16>(out, input, weights, scales, expert_ids, true);
+  } else {
+    STD_TORCH_CHECK(stable_array_ref_eq(input.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({6, 512})) &&
+                    stable_array_ref_eq(out.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({6, 4096})) &&
+                    stable_array_ref_eq(weights.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({256, 512, 512})) &&
+                    stable_array_ref_eq(scales.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({256, 16, 4096})),
+                "mxfp4_moe_qpn_m1_sm70_out: W2 tensor contract mismatch");
+    launch_mxfp4_qpn_m1<8>(out, input, weights, scales, expert_ids, false);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
