+void nvfp4_gemv_sm70_raw_out(torch::stable::Tensor out, torch::stable::Tensor in_feats,
+                             torch::stable::Tensor qweight_packed, torch::stable::Tensor scales,
+                             torch::stable::Tensor partials, int64_t group_size,
+                             int64_t split_k) {
+  STD_TORCH_CHECK(in_feats.is_cuda(), "nvfp4_gemv_sm70_raw: input must be CUDA.");
+  STD_TORCH_CHECK(qweight_packed.is_cuda(),
+              "nvfp4_gemv_sm70_raw: weight must be CUDA.");
+  STD_TORCH_CHECK(scales.is_cuda(), "nvfp4_gemv_sm70_raw: scales must be CUDA.");
+  STD_TORCH_CHECK(out.is_cuda(), "nvfp4_gemv_sm70_raw: output must be CUDA.");
+  STD_TORCH_CHECK(in_feats.scalar_type() == torch::headeronly::ScalarType::Half,
+              "nvfp4_gemv_sm70_raw: input must be float16.");
+  STD_TORCH_CHECK(qweight_packed.scalar_type() == torch::headeronly::ScalarType::Int,
+              "nvfp4_gemv_sm70_raw: packed weight must be int32.");
+  STD_TORCH_CHECK(scales.scalar_type() == torch::headeronly::ScalarType::Half,
+              "nvfp4_gemv_sm70_raw: scales must be float16.");
+  STD_TORCH_CHECK(out.scalar_type() == torch::headeronly::ScalarType::Half,
+              "nvfp4_gemv_sm70_raw: output must be float16.");
+  STD_TORCH_CHECK(group_size == 16,
+              "nvfp4_gemv_sm70_raw: only group_size=16 is supported.");
+  STD_TORCH_CHECK(split_k >= 1 && split_k <= 256,
+              "nvfp4_gemv_sm70_raw: split_k must be in [1, 256].");
+  STD_TORCH_CHECK(in_feats.dim() == 2 && in_feats.size(0) == 1,
+              "nvfp4_gemv_sm70_raw: only M=1 input is supported.");
+  STD_TORCH_CHECK(out.dim() == 2 && out.size(0) == 1,
+              "nvfp4_gemv_sm70_raw: output must be [1, N].");
+  STD_TORCH_CHECK(out.stride(1) == 1,
+              "nvfp4_gemv_sm70_raw: output must be row-major contiguous.");
+  STD_TORCH_CHECK(qweight_packed.dim() == 2,
+              "nvfp4_gemv_sm70_raw: packed weight must be 2D.");
+  STD_TORCH_CHECK(scales.dim() == 2, "nvfp4_gemv_sm70_raw: scales must be 2D.");
+
+  const int64_t k = in_feats.size(1);
+  const int64_t n = out.size(1);
+  STD_TORCH_CHECK(k % group_size == 0,
+              "nvfp4_gemv_sm70_raw: K must be divisible by group_size.");
+  STD_TORCH_CHECK(n % 8 == 0, "nvfp4_gemv_sm70_raw: N must be divisible by 8.");
+  STD_TORCH_CHECK(qweight_packed.size(0) == k && qweight_packed.size(1) == n / 8,
+              "nvfp4_gemv_sm70_raw: packed weight shape mismatch.");
+  STD_TORCH_CHECK(scales.size(0) == k / group_size && scales.size(1) == n,
+              "nvfp4_gemv_sm70_raw: scales shape mismatch.");
+  if (split_k > 1) {
+    STD_TORCH_CHECK(partials.is_cuda(),
+                "nvfp4_gemv_sm70_raw: partials must be CUDA.");
+    STD_TORCH_CHECK(partials.scalar_type() == torch::headeronly::ScalarType::Float,
+                "nvfp4_gemv_sm70_raw: partials must be float32.");
+    STD_TORCH_CHECK(partials.dim() == 2 && partials.size(0) == split_k &&
+                    partials.size(1) == n,
+                "nvfp4_gemv_sm70_raw: partials shape mismatch.");
+  }
+
+  const torch::stable::accelerator::DeviceGuard device_guard(in_feats.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream();
+  constexpr int kThreads = 128;
+  const int qwords = static_cast<int>(n / 8);
+  const int num_groups = static_cast<int>(k / group_size);
+  const dim3 partial_grid((qwords + kThreads - 1) / kThreads,
+                          static_cast<unsigned int>(split_k));
+  float* partial_ptr = split_k > 1 ? partials.mutable_data_ptr<float>() : nullptr;
+  nvfp4_raw_gemv_partial_kernel<kThreads>
+      <<<partial_grid, kThreads, 0, stream>>>(
+          out.mutable_data_ptr<__half>(), partial_ptr,
+          in_feats.const_data_ptr<__half>(),
+          reinterpret_cast<const uint32_t*>(qweight_packed.const_data_ptr<int32_t>()),
+          scales.const_data_ptr<__half>(),
+          static_cast<int>(k), static_cast<int>(n), num_groups,
+          static_cast<int>(split_k));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+
+  if (split_k > 1) {
+    const dim3 reduce_grid((qwords + kThreads - 1) / kThreads);
+    nvfp4_raw_gemv_reduce_kernel<kThreads>
+        <<<reduce_grid, kThreads, 0, stream>>>(
+            out.mutable_data_ptr<__half>(), partial_ptr,
+            static_cast<int>(n), static_cast<int>(split_k));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+  }
+}
