+                layer.w13_tm_scales[:, :, 256:],
+                w13_k_ld,
+                w13_q_ld,
+                num_experts,
+            )
+            layer.w13_head_strided_ptrs_w = Parameter(
+                w13_head_ptrs[0], requires_grad=False
