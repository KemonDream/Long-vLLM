+                  permuted_input.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  permuted_input.is_contiguous() &&
+                  stable_array_ref_eq(permuted_input.sizes(),
+                                      torch::headeronly::IntHeaderOnlyArrayRef(
+                                          {kGlm53MoeQ8Slots, kGlm53MoeQ8Hidden})),
+              "sm70_glm53_moe_permute_q8_out: permuted_input must be "
+              "contiguous CUDA float16 [64, 4096].");
+  for (const auto& item :
+       std::initializer_list<std::pair<const char*, torch::stable::Tensor>>{
+           {"sorted_row_idx", sorted_row_idx},
+           {"inv_permuted_idx", inv_permuted_idx},
+           {"compact_offsets", compact_offsets},
+           {"active_expert_ids", active_expert_ids}}) {
+    STD_TORCH_CHECK(item.second.is_cuda() &&
+                    item.second.scalar_type() == torch::headeronly::ScalarType::Int &&
