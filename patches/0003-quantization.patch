+void validate_f16_gate_mul_input(const torch::stable::Tensor& out,
+                                 const torch::stable::Tensor& in_feats,
+                                 const torch::stable::Tensor& gate_weight) {
+  STD_TORCH_CHECK(out.is_cuda(), "sm70_f16_gate_mul_out: out must be CUDA.");
+  STD_TORCH_CHECK(in_feats.is_cuda(), "sm70_f16_gate_mul_out: input must be CUDA.");
+  STD_TORCH_CHECK(gate_weight.is_cuda(),
+              "sm70_f16_gate_mul_out: gate weight must be CUDA.");
+  STD_TORCH_CHECK(out.scalar_type() == torch::headeronly::ScalarType::Half,
+              "sm70_f16_gate_mul_out: out must be float16.");
+  STD_TORCH_CHECK(in_feats.scalar_type() == torch::headeronly::ScalarType::Half,
+              "sm70_f16_gate_mul_out: input must be float16.");
+  STD_TORCH_CHECK(gate_weight.scalar_type() == torch::headeronly::ScalarType::Half,
+              "sm70_f16_gate_mul_out: gate weight must be float16.");
+  STD_TORCH_CHECK(out.dim() == 2, "sm70_f16_gate_mul_out: out must be 2D.");
+  STD_TORCH_CHECK(in_feats.dim() == 2, "sm70_f16_gate_mul_out: input must be 2D.");
+  STD_TORCH_CHECK(gate_weight.dim() == 2,
+              "sm70_f16_gate_mul_out: gate weight must be 2D.");
+  STD_TORCH_CHECK(gate_weight.size(0) == 1,
+              "sm70_f16_gate_mul_out: gate weight must have one output row.");
+  STD_TORCH_CHECK(out.size(0) == in_feats.size(0),
+              "sm70_f16_gate_mul_out: out/input batch mismatch.");
+  STD_TORCH_CHECK(out.stride(1) == 1,
+              "sm70_f16_gate_mul_out: out must be row-major contiguous.");
+  STD_TORCH_CHECK(in_feats.stride(1) == 1,
+              "sm70_f16_gate_mul_out: input must be row-major contiguous.");
+  STD_TORCH_CHECK(gate_weight.stride(1) == 1,
+              "sm70_f16_gate_mul_out: gate weight must be contiguous.");
+  STD_TORCH_CHECK(in_feats.size(1) == gate_weight.size(1),
+              "sm70_f16_gate_mul_out: input/gate K mismatch.");
+}
