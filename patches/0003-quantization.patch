+      x.is_cuda() && x.scalar_type() == torch::headeronly::ScalarType::Half,
+      "fp8_moe_single_token_dense_w13_sm70_out: x must be CUDA float16.");
+  STD_TORCH_CHECK(gate_up.is_cuda() && gate_up.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  compact_input.is_cuda() &&
+                  compact_input.scalar_type() == torch::headeronly::ScalarType::Half,
+              "fp8_moe_single_token_dense_w13_sm70_out: scratch buffers must "
+              "be CUDA float16.");
+  STD_TORCH_CHECK(topk_ids.is_cuda() && topk_ids.scalar_type() == torch::headeronly::ScalarType::Int &&
+                  topk_ids.is_contiguous(),
+              "fp8_moe_single_token_dense_w13_sm70_out: topk_ids must be "
+              "contiguous CUDA int32.");
+  STD_TORCH_CHECK(expert_offsets.is_cuda() &&
+                  expert_offsets.scalar_type() == torch::headeronly::ScalarType::Int &&
+                  expert_offsets64.is_cuda() &&
+                  expert_offsets64.scalar_type() == torch::headeronly::ScalarType::Long &&
+                  inv_permuted_idx.is_cuda() &&
+                  inv_permuted_idx.scalar_type() == torch::headeronly::ScalarType::Int &&
+                  sorted_expert_ids.is_cuda() &&
+                  sorted_expert_ids.scalar_type() == torch::headeronly::ScalarType::Int,
+              "fp8_moe_single_token_dense_w13_sm70_out: index buffers must be "
+              "CUDA int32/int64.");
+  STD_TORCH_CHECK(
+      expert_offsets.is_contiguous() && expert_offsets64.is_contiguous() &&
+          inv_permuted_idx.is_contiguous() && sorted_expert_ids.is_contiguous(),
+      "fp8_moe_single_token_dense_w13_sm70_out: index buffers must be "
+      "contiguous.");
+  STD_TORCH_CHECK(
+      w13_ptrs_w.is_cuda() && w13_ptrs_s.is_cuda(),
