+void sm70_dynamic_draft_vocab_refresh_tail_weight_out(
+    torch::stable::Tensor local_tail_weight, torch::stable::Tensor source_weight,
+    torch::stable::Tensor source_row_indices) {
+  STD_TORCH_CHECK(local_tail_weight.is_cuda() && source_weight.is_cuda() &&
+                  source_row_indices.is_cuda(),
+              "sm70_dynamic_draft_vocab_refresh_tail_weight_out: tensors must "
+              "be CUDA.");
+  STD_TORCH_CHECK(local_tail_weight.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  source_weight.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  source_row_indices.scalar_type() == torch::headeronly::ScalarType::Long,
+              "sm70_dynamic_draft_vocab_refresh_tail_weight_out: invalid "
+              "tensor dtype.");
+  STD_TORCH_CHECK(local_tail_weight.dim() == 2 && source_weight.dim() == 2 &&
+                  source_row_indices.dim() == 1 &&
+                  local_tail_weight.size(0) == source_row_indices.numel() &&
+                  local_tail_weight.size(1) == source_weight.size(1) &&
+                  source_weight.size(0) > 0,
+              "sm70_dynamic_draft_vocab_refresh_tail_weight_out: invalid "
+              "tensor shape.");
+  STD_TORCH_CHECK(local_tail_weight.is_contiguous() &&
+                  source_weight.is_contiguous() &&
+                  source_row_indices.is_contiguous(),
+              "sm70_dynamic_draft_vocab_refresh_tail_weight_out: tensors must "
+              "be contiguous.");
+  const int device = local_tail_weight.get_device();
+  STD_TORCH_CHECK(source_weight.get_device_index() == device &&
+                  source_row_indices.get_device_index() == device,
+              "sm70_dynamic_draft_vocab_refresh_tail_weight_out: tensors must "
+              "share a device.");
+  STD_TORCH_CHECK(
+      local_tail_weight.size(0) <= std::numeric_limits<int>::max() &&
+          source_weight.size(0) <= std::numeric_limits<int>::max() &&
+          source_weight.size(1) <= std::numeric_limits<int>::max(),
+      "sm70_dynamic_draft_vocab_refresh_tail_weight_out: tensor is too large.");
+
+  constexpr int kThreads = 256;
+  const dim3 grid(static_cast<unsigned int>(
+                      (source_weight.size(1) + kThreads - 1) / kThreads),
+                  static_cast<unsigned int>(local_tail_weight.size(0)));
+  const torch::stable::accelerator::DeviceGuard device_guard(local_tail_weight.get_device_index());
+  const auto stream = get_current_cuda_stream();
+  sm70_dynamic_draft_vocab_refresh_tail_weight_kernel<<<grid, kThreads, 0,
+                                                        stream>>>(
+      local_tail_weight.mutable_data_ptr<half>(),
+      reinterpret_cast<const half*>(source_weight.const_data_ptr<half>()),
+      source_row_indices.const_data_ptr<int64_t>(),
+      static_cast<int>(source_weight.size(0)),
+      static_cast<int>(source_weight.size(1)));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
