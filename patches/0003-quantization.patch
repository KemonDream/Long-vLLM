+void fp8_moe_single_token_dense_stage_sm70_out(
+    torch::stable::Tensor out, torch::stable::Tensor input, torch::stable::Tensor expert_offsets,
+    torch::stable::Tensor sorted_expert_ids, torch::stable::Tensor ptrs_w, torch::stable::Tensor ptrs_s,
+    int64_t top_k, int64_t k, int64_t n, int64_t group_size) {
+  STD_TORCH_CHECK(
