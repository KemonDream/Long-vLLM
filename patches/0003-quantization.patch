+  STD_TORCH_CHECK(
+      top_k > 0 && top_k <= 32,
+      "fp8_moe_single_token_dense_stage_sm70_out: top_k must be in [1, 32].");
+  STD_TORCH_CHECK(
+      input.dim() == 2 && input.size(0) >= top_k && input.size(1) == k,
+      "fp8_moe_single_token_dense_stage_sm70_out: input shape mismatch.");
