+                  weights.is_contiguous() && scales.is_contiguous() &&
+                  expert_ids.is_contiguous(),
+              "nvfp4_moe_qpn_w13_swiglu_batch_sm70_out: tensors must be "
+              "contiguous");
+  const int64_t tokens = input.size(0);
+  const int64_t routes = tokens * 10;
+  STD_TORCH_CHECK((tokens == 4 || tokens == 8 || tokens == 16) &&
+                  stable_array_ref_eq(out.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({routes, 160})) &&
+                  stable_array_ref_eq(input.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({tokens, 2560})) &&
