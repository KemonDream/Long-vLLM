+void nvfp4_expand_raw_scales_sm70_out(torch::stable::Tensor out,
+                                      torch::stable::Tensor scale_codes,
+                                      torch::stable::Tensor global_scales,
+                                      bool interleaved_w13,
+                                      bool fast_decode_rounding) {
+  STD_TORCH_CHECK(out.is_cuda() && scale_codes.is_cuda() && global_scales.is_cuda(),
+              "nvfp4_expand_raw_scales_sm70_out: tensors must be CUDA");
+  STD_TORCH_CHECK(out.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  scale_codes.scalar_type() == torch::headeronly::ScalarType::Byte &&
+                  global_scales.scalar_type() == torch::headeronly::ScalarType::Float,
+              "nvfp4_expand_raw_scales_sm70_out: dtype mismatch");
+  STD_TORCH_CHECK(out.is_contiguous() && scale_codes.is_contiguous() &&
+                  global_scales.is_contiguous(),
+              "nvfp4_expand_raw_scales_sm70_out: tensors must be contiguous");
+  STD_TORCH_CHECK(stable_tensor_sizes_equal(out, scale_codes) && out.dim() == 3 &&
+                  out.size(0) == 512,
+              "nvfp4_expand_raw_scales_sm70_out: scale shape mismatch");
+  const bool is_w13 = stable_array_ref_eq(out.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({512, 160, 320}));
+  const bool is_w2 = stable_array_ref_eq(out.sizes(), torch::headeronly::IntHeaderOnlyArrayRef({512, 10, 2560}));
+  STD_TORCH_CHECK(is_w13 || is_w2,
+              "nvfp4_expand_raw_scales_sm70_out: unsupported Qwen3.8 shape");
+  const auto gs_shape = is_w13 ? torch::headeronly::IntHeaderOnlyArrayRef({512, 2})
+                                : torch::headeronly::IntHeaderOnlyArrayRef({512, 1});
+  STD_TORCH_CHECK(stable_array_ref_eq(global_scales.sizes(), gs_shape),
+              "nvfp4_expand_raw_scales_sm70_out: global-scale shape mismatch");
+  STD_TORCH_CHECK(out.get_device_index() == scale_codes.get_device_index() &&
+                  out.get_device_index() == global_scales.get_device_index(),
+              "nvfp4_expand_raw_scales_sm70_out: device mismatch");
+
+  const torch::stable::accelerator::DeviceGuard device_guard(out.get_device_index());
+  constexpr int threads = 256;
+  const size_t elements = static_cast<size_t>(out.numel());
+  const int blocks = static_cast<int>((elements + threads - 1) / threads);
+  nvfp4_expand_raw_scales_sm70_kernel<<<blocks, threads, 0,
+                                        get_current_cuda_stream()>>>(
+      reinterpret_cast<half*>(out.mutable_data_ptr<half>()),
+      scale_codes.const_data_ptr<uint8_t>(), global_scales.const_data_ptr<float>(),
+      elements, static_cast<size_t>(out.numel() / out.size(0)),
+      static_cast<int>(out.size(2)), is_w13 ? 2 : 1, interleaved_w13,
+      fast_decode_rounding);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
