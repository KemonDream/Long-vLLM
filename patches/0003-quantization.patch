+            layer.w2_strided_ptrs_s,
+            stage_expert_count,
+            layer.sm70_mxfp4_w2_k_dim,
+            layer.sm70_mxfp4_w2_n_dim,
+            layer.sm70_mxfp4_group_size,
+        )
