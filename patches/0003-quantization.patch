+void fp8_qpn8_prefill_sm70_out(torch::stable::Tensor out, int64_t dense_weight_ptr,
+                               torch::stable::Tensor input, torch::stable::Tensor codes,
+                               torch::stable::Tensor group_scales, bool gated_silu) {
+  STD_TORCH_CHECK(input.is_cuda() && out.is_cuda(),
+              "fp8_qpn8_prefill_sm70_out: input and output must be CUDA");
+  STD_TORCH_CHECK(input.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  out.scalar_type() == torch::headeronly::ScalarType::Half,
+              "fp8_qpn8_prefill_sm70_out: input and output must be float16");
+  STD_TORCH_CHECK(input.dim() == 2 && out.dim() == 2 && dense_weight_ptr != 0,
+              "fp8_qpn8_prefill_sm70_out: invalid input or workspace");
+  STD_TORCH_CHECK(input.is_contiguous() && out.is_contiguous(),
+              "fp8_qpn8_prefill_sm70_out: tensors must be contiguous");
+
+  const int64_t m = input.size(0);
+  const int64_t k = input.size(1);
+  const int64_t n = codes.size(1);
+  STD_TORCH_CHECK(codes.dim() == 2 && codes.size(0) == k,
+              "fp8_qpn8_prefill_sm70_out: code shape mismatch");
+  STD_TORCH_CHECK(out.size(0) == m && out.size(1) == (gated_silu ? n / 2 : n),
+              "fp8_qpn8_prefill_sm70_out: output shape mismatch");
+
+  auto dense_weight = torch::stable::from_blob(
+      reinterpret_cast<void*>(dense_weight_ptr), {k, n}, {n, 1},
+      input.device(), torch::headeronly::ScalarType::Half);
+  fp8_qpn8_dequantize_sm70_out(dense_weight, codes, group_scales);
+  if (!gated_silu) {
+    torch::stable::copy_(out, torch::stable::matmul(input, dense_weight));
+    return;
+  }
+
+  auto gate_up = torch::stable::matmul(input, dense_weight);
+  constexpr int kThreads = 256;
+  fp8_qpn8_silu_and_mul_sm70_kernel<<<static_cast<int>(m), kThreads, 0,
+                                      get_current_cuda_stream()>>>(
+      reinterpret_cast<half*>(out.mutable_data_ptr<half>()),
+      reinterpret_cast<const half*>(gate_up.const_data_ptr<half>()),
+      static_cast<int>(m), static_cast<int>(n / 2));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
