+    CUTLASS_HOST_DEVICE
+    Params(int lda_, int moe_block_size_, int top_k_, int size_m_,
+           int expanded_token_count_, int padded_tokens_)
+        : lda(lda_),
+          moe_block_size(moe_block_size_),
