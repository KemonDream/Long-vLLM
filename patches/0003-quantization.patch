+void awq_moe_chunked_w2_sm70_out(
+    torch::stable::Tensor out, torch::stable::Tensor chunk_output, torch::stable::Tensor input,
+    torch::stable::Tensor expert_offsets, torch::stable::Tensor permuted_idx,
