+torch::stable::Tensor interleave_gated_silu_cols(torch::stable::Tensor tensor) {
+  const int64_t rows = tensor.size(0);
+  const int64_t n = tensor.size(1);
+  STD_TORCH_CHECK((n % 2) == 0,
+              "awq_sm70_prepare: gated_silu interleave requires even columns.");
+  const int64_t half = n / 2;
+  auto out = torch::stable::empty(tensor.sizes(), tensor.scalar_type(), std::nullopt,
+                                   tensor.device());
+  for (int64_t i = 0; i < half; ++i) {
+    auto dst_even = torch::stable::narrow(out, 1, 2 * i, 1);
+    torch::stable::copy_(dst_even, torch::stable::narrow(tensor, 1, i, 1));
+    auto dst_odd = torch::stable::narrow(out, 1, 2 * i + 1, 1);
+    torch::stable::copy_(dst_odd, torch::stable::narrow(tensor, 1, half + i, 1));
+  }
+  return out;
+}
+
+__global__ void pack_awq_compact_source_kernel(uint32_t* packed,
+                                               const half* scales,
+                                               const uint8_t* zeros,
+                                               int64_t numel) {
+  const int64_t idx =
+      static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (idx < numel) {
+    const uint16_t scale_bits = __half_as_ushort(scales[idx]);
+    packed[idx] = static_cast<uint32_t>(scale_bits) |
+                  (static_cast<uint32_t>(zeros[idx]) << 16);
+  }
+}
+
+__global__ void compact_awq_stats_kernel(uint8_t* compact,
+                                         const uint32_t* packed,
+                                         int64_t numel) {
+  const int64_t idx =
+      static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (idx < numel) {
+    const uint32_t value = packed[idx];
+    compact[idx * 3] = static_cast<uint8_t>(value);
+    compact[idx * 3 + 1] = static_cast<uint8_t>(value >> 8);
+    compact[idx * 3 + 2] = static_cast<uint8_t>(value >> 16);
+  }
+}
