+  STD_TORCH_CHECK(num_tokens <= kIntMax / top_k && num_experts <= kIntMax &&
+                  k <= kIntMax && n <= kIntMax &&
+                  hidden_logical_size <= kIntMax && group_size <= kIntMax &&
+                  chunk_tokens <= kIntMax,
+              "awq_moe_chunked_w2_sm70_out: dimensions exceed int32.");
