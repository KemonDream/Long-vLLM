+          chunk_range_end.dim() == 1 &&
+          chunk_range_end.numel() >= num_experts &&
+          chunk_a_indices.dim() == 1 &&
+          chunk_a_indices.numel() >= max_chunk_slots &&
+          chunk_inv_permuted_idx.dim() == 1 &&
+          chunk_inv_permuted_idx.numel() >= max_chunk_slots,
