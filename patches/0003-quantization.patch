+    scales = layer.weight_scale.data.t().contiguous()
+    tm_weight, tm_scales, meta = sm70_ops.mxfp4_sm70_prepare(
+        qweight, scales, MXFP4_GROUP_SIZE, interleave_gated_silu
+    )
+    _store_state(
+        layer,
+        tm_weight,
+        tm_scales,
+        meta,
+        MXFP4_GROUP_SIZE,
+        qweight.size(1),
+        "mxfp4",
+    )
