+void sm70_sample_packed_top20_out(torch::stable::Tensor sampled_token_out,
+                                  torch::stable::Tensor sparse_ids_out,
+                                  torch::stable::Tensor sparse_probs_out,
+                                  torch::stable::Tensor gathered_pairs,
+                                  torch::stable::Tensor exponential, double top_p) {
+  constexpr int top_k = 20;
+  STD_TORCH_CHECK(sampled_token_out.is_cuda() && sparse_ids_out.is_cuda() &&
+                  sparse_probs_out.is_cuda() && gathered_pairs.is_cuda() &&
+                  exponential.is_cuda(),
+              "sm70_sample_packed_top20_out: tensors must be CUDA.");
+  STD_TORCH_CHECK(sampled_token_out.scalar_type() == torch::headeronly::ScalarType::Long &&
+                  sparse_ids_out.scalar_type() == torch::headeronly::ScalarType::Long &&
+                  sparse_probs_out.scalar_type() == torch::headeronly::ScalarType::Float &&
+                  gathered_pairs.scalar_type() == torch::headeronly::ScalarType::Float &&
+                  exponential.scalar_type() == torch::headeronly::ScalarType::Float,
+              "sm70_sample_packed_top20_out: invalid tensor dtype.");
+  STD_TORCH_CHECK(
+      sampled_token_out.numel() == 1 && sparse_ids_out.numel() == top_k &&
+          sparse_probs_out.numel() == top_k &&
+          gathered_pairs.numel() >= top_k * 3 &&
+          gathered_pairs.numel() % 3 == 0 && exponential.numel() >= top_k,
+      "sm70_sample_packed_top20_out: invalid tensor shape.");
+  STD_TORCH_CHECK(sampled_token_out.is_contiguous() &&
+                  sparse_ids_out.is_contiguous() &&
+                  sparse_probs_out.is_contiguous() &&
+                  gathered_pairs.is_contiguous() && exponential.is_contiguous(),
+              "sm70_sample_packed_top20_out: tensors must be contiguous.");
+  STD_TORCH_CHECK(top_p > 0.0 && top_p <= 1.0,
+              "sm70_sample_packed_top20_out: top_p must be in (0, 1].");
+
+  const torch::stable::accelerator::DeviceGuard device_guard(gathered_pairs.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream();
+  sm70_sample_packed_top20_kernel<<<1, WARP_SIZE, 0, stream>>>(
+      sampled_token_out.mutable_data_ptr<int64_t>(), sparse_ids_out.mutable_data_ptr<int64_t>(),
+      sparse_probs_out.mutable_data_ptr<float>(), gathered_pairs.const_data_ptr<float>(),
+      static_cast<int>(gathered_pairs.numel() / 3),
+      exponential.const_data_ptr<float>(), static_cast<int>(exponential.numel()),
+      static_cast<float>(top_p));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
