+void fp8_qpn8_dispatch_sm70_out(torch::stable::Tensor out, int64_t dense_weight_ptr,
+                                torch::stable::Tensor input, torch::stable::Tensor codes,
+                                torch::stable::Tensor group_scales, int64_t split_k,
+                                int64_t accumulator_chains, bool prefetch_codes,
+                                bool gated_silu);
+
+void fp8_qpn8_dispatch_ba_split_sm70_out(
+    torch::stable::Tensor qkv_out, torch::stable::Tensor z_out, torch::stable::Tensor b_out,
+    torch::stable::Tensor a_out, torch::stable::Tensor qkvz_staging, torch::stable::Tensor ba_staging,
+    int64_t dense_weight_ptr, torch::stable::Tensor input, torch::stable::Tensor codes,
+    torch::stable::Tensor group_scales, torch::stable::Tensor ba_weight) {
+  const int64_t k = input.size(1);
+  constexpr int64_t n = 4096;
+  constexpr int64_t qkv_n = 2560;
+  constexpr int64_t z_n = n - qkv_n;
+  constexpr int64_t ba_n = 24;
+  const int64_t m = input.size(0);
+  STD_TORCH_CHECK(input.dim() == 2 && (k == 2560 || k == 5120) && m >= 1,
+              "fp8_qpn8_dispatch_ba_split_sm70_out: bad input shape");
+  STD_TORCH_CHECK(qkv_out.is_cuda() && z_out.is_cuda() && b_out.is_cuda() &&
+                  a_out.is_cuda() && qkvz_staging.is_cuda() &&
+                  ba_staging.is_cuda() && input.is_cuda() && codes.is_cuda() &&
+                  group_scales.is_cuda() && ba_weight.is_cuda(),
+              "fp8_qpn8_dispatch_ba_split_sm70_out: tensors must be CUDA");
+  STD_TORCH_CHECK(qkv_out.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  z_out.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  b_out.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  a_out.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  qkvz_staging.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  ba_staging.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  input.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  group_scales.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  ba_weight.scalar_type() == torch::headeronly::ScalarType::Half &&
+                  codes.scalar_type() == torch::headeronly::ScalarType::Byte,
+              "fp8_qpn8_dispatch_ba_split_sm70_out: dtype mismatch");
+  STD_TORCH_CHECK(
+      qkv_out.is_contiguous() && z_out.is_contiguous() &&
+          b_out.is_contiguous() && a_out.is_contiguous() &&
+          qkvz_staging.is_contiguous() && ba_staging.is_contiguous() &&
+          input.is_contiguous() && codes.is_contiguous() &&
+          group_scales.is_contiguous() && ba_weight.is_contiguous(),
+      "fp8_qpn8_dispatch_ba_split_sm70_out: tensors must be contiguous");
+  STD_TORCH_CHECK(
+      qkv_out.numel() == m * qkv_n && z_out.numel() == m * z_n &&
+          b_out.numel() == m * ba_n / 2 && a_out.numel() == m * ba_n / 2 &&
+          qkvz_staging.numel() == m * n && ba_staging.numel() == m * ba_n,
+      "fp8_qpn8_dispatch_ba_split_sm70_out: output shape mismatch");
+  STD_TORCH_CHECK(
+      qkv_out.device().index() == z_out.device().index() &&
+          qkv_out.device().index() == b_out.device().index() &&
+          qkv_out.device().index() == a_out.device().index() &&
+          qkv_out.device().index() == qkvz_staging.device().index() &&
+          qkv_out.device().index() == ba_staging.device().index() &&
+          qkv_out.device().index() == input.device().index() &&
+          qkv_out.device().index() == codes.device().index() &&
+          qkv_out.device().index() == group_scales.device().index() &&
+          qkv_out.device().index() == ba_weight.device().index(),
+      "fp8_qpn8_dispatch_ba_split_sm70_out: tensors must share one device");
+  STD_TORCH_CHECK(codes.dim() == 2 && codes.size(0) == k && codes.size(1) == n,
+              "fp8_qpn8_dispatch_ba_split_sm70_out: code shape mismatch");
+  STD_TORCH_CHECK(group_scales.dim() == 2 && group_scales.size(0) == 1 &&
+                  group_scales.size(1) == n,
+              "fp8_qpn8_dispatch_ba_split_sm70_out: scale shape mismatch");
+  STD_TORCH_CHECK(ba_weight.dim() == 2 && ba_weight.size(0) == ba_n &&
+                  ba_weight.size(1) == k,
+              "fp8_qpn8_dispatch_ba_split_sm70_out: b/a weight mismatch");
+  STD_TORCH_CHECK(m <= 8 || dense_weight_ptr != 0,
+              "fp8_qpn8_dispatch_ba_split_sm70_out: large-M requires the "
+              "dense QPN8 workspace");
+
+  if (m == 1) {
+    static std::once_flag route_log_once;
+    std::call_once(route_log_once, []() {
+      std::fprintf(stderr,
+                   "SM70 GDN QPN8 N4096 + FP16 b/a N24 split C++ route "
+                   "enabled.\n");
+      std::fflush(stderr);
+    });
+    fp8_qpn8_gemm_ba_split_sm70_out(qkv_out, z_out, b_out, a_out, input, codes,
+                                    group_scales, ba_weight);
+    return;
+  }
+
+  fp8_qpn8_dispatch_sm70_out(qkvz_staging, dense_weight_ptr, input, codes,
+                             group_scales, 16, 2, false, false);
+  torch::stable::copy_(ba_staging,
+                        torch::stable::matmul(input,
+                                              torch::stable::transpose(
+                                                  ba_weight, 0, 1)));
+  const torch::stable::accelerator::DeviceGuard device_guard(input.get_device_index());;
+  constexpr int threads = 256;
+  const int64_t elements = m * (n + ba_n);
+  const int blocks = static_cast<int>((elements + threads - 1) / threads);
+  fp8_qpn8_ba_split_copy_sm70_kernel<<<blocks, threads, 0,
+                                       get_current_cuda_stream()>>>(
+      reinterpret_cast<const half*>(qkvz_staging.const_data_ptr<half>()),
+      reinterpret_cast<const half*>(ba_staging.const_data_ptr<half>()),
+      reinterpret_cast<half*>(qkv_out.mutable_data_ptr<half>()),
+      reinterpret_cast<half*>(z_out.mutable_data_ptr<half>()),
+      reinterpret_cast<half*>(b_out.mutable_data_ptr<half>()),
+      reinterpret_cast<half*>(a_out.mutable_data_ptr<half>()), static_cast<int>(m));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
