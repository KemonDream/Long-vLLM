+            )
+            buffers["sorted_output"] = _dump_awq_moe_buffer(
+                layer, buffers["sorted_output"], "w2_dense_out"
+            )
+        sorted_output = buffers["sorted_output"][:, : layer.sm70_hidden_logical_size]
+        torch.ops._moe_C.moe_unpermute(
+            sorted_output,
+            topk_weights,
