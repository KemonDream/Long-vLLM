+unsigned sm70_capture_status_bit(cudaStreamCaptureStatus status) {
+  switch (status) {
+    case cudaStreamCaptureStatusNone:
+      return 1u;
+    case cudaStreamCaptureStatusActive:
+      return 2u;
+    case cudaStreamCaptureStatusInvalidated:
+      return 4u;
+    default:
+      return 8u;
