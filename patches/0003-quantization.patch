+  const char* shuffle_sort_raw =
+      std::getenv("VLLM_SM70_GLM53_MOE_SHUFFLE_SORT_Q8");
+  const bool use_shuffle_sort =
+      shuffle_sort_raw == nullptr || std::atoi(shuffle_sort_raw) != 0;
