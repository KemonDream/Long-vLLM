+          reinterpret_cast<const uint32_t*>(weights.const_data_ptr<int32_t>()),
+          scales.const_data_ptr<half>(), nullptr, expert_ids.const_data_ptr<int32_t>(),
+          topk_weights.const_data_ptr<float>(),
+          reinterpret_cast<half*>(out.mutable_data_ptr<half>()),
+          static_cast<int>(tokens));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
