+  const int device = input.get_device();
+  STD_TORCH_CHECK(
+      out.get_device_index() == device && chunk_output.get_device_index() == device &&
+          expert_offsets.get_device_index() == device &&
+          permuted_idx.get_device_index() == device &&
+          topk_weights.get_device_index() == device &&
+          chunk_expert_offsets.get_device_index() == device &&
+          chunk_range_begin.get_device_index() == device &&
+          chunk_range_end.get_device_index() == device &&
+          chunk_a_indices.get_device_index() == device &&
+          chunk_inv_permuted_idx.get_device_index() == device &&
+          ptrs_w.get_device_index() == device && ptrs_s.get_device_index() == device,
