+      expert_offsets.numel() >= top_k + 1 && sorted_expert_ids.numel() >= top_k,
+      "fp8_moe_single_token_dense_stage_sm70_out: index buffer too small.");
+  STD_TORCH_CHECK(group_size == 128,
+              "fp8_moe_single_token_dense_stage_sm70_out: only group_size=128 "
+              "is supported.");
+
+  const torch::stable::accelerator::DeviceGuard device_guard(input.get_device_index());
+  for (int route = 0; route < static_cast<int>(top_k); ++route) {
+    torch::stable::Tensor offsets = torch::stable::narrow(expert_offsets, 0, route, 2);
+    torch::stable::Tensor expert_idx = torch::stable::narrow(sorted_expert_ids, 0, route, 1);
+    fp8_moe_gemm_sm70_out_impl(out, input, offsets, ptrs_w, ptrs_s, 1, k, n,
+                               group_size, false, torch::stable::Tensor(),
