+    VLLM_NVFP4_QPN_M1_CASE(20);
+    VLLM_NVFP4_QPN_M1_CASE(32);
+    default:
+      STD_TORCH_CHECK(false, "nvfp4_moe_qpn_m1_sm70_out: unsupported split_k ",
+                  split_k);
