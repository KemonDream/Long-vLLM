+def flashqla_sm70_chunk_gated_delta_rule(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    initial_state: torch.Tensor,
+    output_final_state: bool,
+    cu_seqlens: torch.Tensor | None = None,
+    use_qk_l2norm_in_kernel: bool = False,
+    core_attn_out: torch.Tensor | None = None,
+) -> tuple[torch.Tensor, torch.Tensor | None]:
+    """SM70 fused GDN chunked prefill via the FlashQLA VLK varlen kernel.
+
+    Replaces the Triton/FLA pipeline (chunk_scaled_dot_kkt + solve_tril +
+    recompute_w_u + chunk_delta_h + chunk_o) with a single launch. The kernel
+    writes vLLM's ``[N, Hv, V, K]`` temporal state layout directly.
+
+    Inputs must be contiguous and fp16; unnormalised q/k overflow fp16 dot
+    products, so the caller is expected to have normalised already
+    (``use_qk_l2norm_in_kernel`` then stays False, as it is on the prefill path).
+    """
+    from flash_qla.ops.gated_delta_rule.chunk.sm70 import (
+        chunk_gated_delta_rule_fwd_sm70_vlk_varlen,
+    )
+
+    if use_qk_l2norm_in_kernel:
+        q = l2norm_fwd(q)
+        k = l2norm_fwd(k)
+
+    if cu_seqlens is None:
+        cu_seqlens = torch.tensor(
+            [0, q.shape[1]], device=q.device, dtype=torch.int32
+        )
+    elif cu_seqlens.dtype != torch.int32:
+        cu_seqlens = cu_seqlens.to(torch.int32)
+
+    output = None
+    if core_attn_out is not None:
+        candidate = core_attn_out[: q.shape[1]].unsqueeze(0)
+        if (
+            candidate.shape == v.shape
+            and candidate.dtype == v.dtype
+            and candidate.is_contiguous()
+        ):
+            # Write straight into the caller's buffer; skips an output copy.
+            output = candidate
+
+    q_arg = q if q.is_contiguous() else q.contiguous()
+    k_arg = k if k.is_contiguous() else k.contiguous()
+    v_arg = v if v.is_contiguous() else v.contiguous()
+    g_arg = g if g.is_contiguous() else g.contiguous()
+    beta_arg = beta if beta.is_contiguous() else beta.contiguous()
+    state_arg = (
+        initial_state if initial_state.is_contiguous() else initial_state.contiguous()
+    )
+    cu_arg = cu_seqlens if cu_seqlens.is_contiguous() else cu_seqlens.contiguous()
