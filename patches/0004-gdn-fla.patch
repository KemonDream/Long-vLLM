+def _sm70_flashqla_prefill_available(vllm_config: VllmConfig) -> bool:
+    """SM70 fused GDN prefill (FlashQLA) is usable for this model.
+
+    Mirrors 1Cat-vLLM's gate: Volta, linear key head dim 128, fp16 activations.
+    The ``[Hv, V, K]`` state layout the kernel writes is exactly vLLM's
+    ``gated_delta_net_state_shape`` temporal layout, so no state transpose is
+    needed (see ``MambaStateShapeCalculator.gated_delta_net_state_shape``).
+
+    ``VLLM_SM70_GDN_FLASHQLA_PREFILL=0`` forces the Triton/FLA path back on, which
+    is the rollback lever for this route.
+    """
+    if not envs.VLLM_SM70_GDN_FLASHQLA_PREFILL:
+        return False
+    if not current_platform.is_cuda() or not current_platform.is_device_capability(70):
+        return False
+    head_k_dim = getattr(
+        vllm_config.model_config.hf_text_config, "linear_key_head_dim", None
+    )
+    if head_k_dim != 128:
+        return False
+    if vllm_config.model_config.dtype != torch.float16:
+        # The SM70 kernel is fp16 production-validated only.
+        return False
+    return _sm70_flashqla_importable()
+
