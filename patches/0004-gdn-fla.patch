+        ok = _probe()
+    except ImportError:
+        # The vendored flash_qla tree sits next to the vllm package
+        # (<repo>/flash_qla and <repo>/vllm/), so it is only importable when the
+        # repo root happens to be on sys.path. Running `python -m
+        # vllm.entrypoints...` from an unrelated cwd does not put it there, which
+        # silently demoted the engine to the Triton FLA path.
+        import sys
+
+        import vllm as _vllm
+
+        # vllm/__init__.py lives at <repo_root>/vllm/__init__.py
+        repo_root = os.path.dirname(os.path.dirname(os.path.abspath(_vllm.__file__)))
+        if repo_root not in sys.path:
+            sys.path.append(repo_root)
+        try:
+            ok = _probe()
+        except Exception:  # noqa: BLE001 - missing .so, missing torch symbols, etc.
+            ok = False
+    except Exception:  # noqa: BLE001
+        ok = False
+    _FLASHQLA_SM70_DECISION.append(ok)
+    return ok
+
