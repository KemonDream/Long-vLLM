+                    "Rebuild vLLM from source with CUDA arch 7.0."
+                )
+            projected = torch.empty(
+                (num_tokens, 6416),
+                dtype=hidden_states.dtype,
+                device=hidden_states.device,
+            )
+            sm70_ops.sm70_glm53_fp16_gemv_out(projected, hidden_states, weight)
