+      va = __fmul_rn(x1, qwen38_hc_half_at(wa, 1));
+      vb = __fmul_rn(x1, qwen38_hc_half_at(wb, 1));
+      va = __fmaf_rn(qwen38_hc_half_at(lora_values, 0),
