+    def _grouped_w2_fake(out, routed, x, w, s, topk, rows, experts, sizes, total):
+        return None
+
+
+def has_nvfp4_qpn_w2_reduce_dispatch() -> bool:
+    return hasattr(
+        torch.ops._C_qwen38,
